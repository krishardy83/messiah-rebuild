---
import Icon from "./icon.astro";

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  panelClass?: string;
}

const { id, title, eyebrow, panelClass } = Astro.props;
const hasMedia = Astro.slots.has("media");
const hasPanel = Astro.slots.has("panel");
---

<!-- Open this drawer from anywhere on the page with a link to #id. -->
<div
  x-data="{ open: false }"
  data-drawer-id={id}
  @click.window="if ($event.target.closest('a[href]')?.getAttribute('href') === '#' + $el.dataset.drawerId) { $event.preventDefault(); open = true; }"
>
  <template x-teleport="body">
    <div
      id={id}
      x-show="open"
      style="display: none"
      x-on:keydown.escape.prevent.stop="open = false"
      role="dialog"
      aria-modal="true"
      aria-labelledby={`${id}-title`}
      class="dialog not-prose"
      data-analytics="drawer"
    >
      <div
        x-show="open"
        @click="open = false"
        x-transition.opacity.duration.300
        class="fixed inset-0 bg-primary-800/80 z-50"
        aria-hidden="true"
      >
      </div>

      <div
        x-show="open"
        x-transition.opacity.duration.300
        x-trap.noscroll.inert="open"
        class="fixed top-0 right-0 bottom-0 w-full md:w-[660px] max-w-full bg-white z-50 overflow-y-auto"
      >
        {
          hasMedia ? (
            <div class="relative">
              <slot name="media" />
              <button
                type="button"
                @click="open = false"
                aria-label="Close dialog"
                class="absolute right-4 top-4 z-10 flex size-12 items-center justify-center bg-white shadow-lg"
              >
                <Icon name="close" class="size-8" />
              </button>
            </div>
          ) : (
            <div class="flex justify-end p-4">
              <button type="button" @click="open = false" aria-label="Close dialog">
                <Icon name="close" class="size-10" />
              </button>
            </div>
          )
        }

        {
          hasPanel ? (
            <>
              <div class:list={["px-4 py-6 md:px-8", panelClass]}>
                {eyebrow && (
                  <p class="mb-2 text-xs font-extrabold uppercase tracking-[.18em] text-[#bd7d0d]">
                    {eyebrow}
                  </p>
                )}
                <h2 id={`${id}-title`} class="h3 text-primary-800 mb-6">
                  {title}
                </h2>
                <slot name="panel" />
              </div>
              <div class="px-4 py-6 md:px-8">
                <slot />
              </div>
            </>
          ) : (
            <div class:list={["px-4 pb-8 md:px-8", hasMedia && "pt-6"]}>
              {eyebrow && (
                <p class="mb-2 text-xs font-extrabold uppercase tracking-[.18em] text-[#bd7d0d]">
                  {eyebrow}
                </p>
              )}
              <h2 id={`${id}-title`} class="h3 text-primary-800 mb-6">
                {title}
              </h2>
              <slot />
            </div>
          )
        }
      </div>
    </div>
  </template>
</div>
