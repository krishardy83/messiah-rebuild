---
type ActiveView = "az" | "interest" | "quiz";

interface Props {
  active: ActiveView;
  variant?: "cards" | "editorial";
}

const { active, variant = "cards" } = Astro.props;
const isEditorial = variant === "editorial";

const views = [
  {
    id: "az",
    href: "/majors-minors-2b/",
    eyebrow: "Search every program",
    label: "A–Z listing",
  },
  {
    id: "interest",
    href: "/majors-minors-2c/",
    eyebrow: "Start with a subject",
    label: "Browse by interest",
  },
  {
    id: "quiz",
    href: "/majors-minors-quiz/",
    eyebrow: "Get a guided match",
    label: "Take the quiz",
  },
] as const;
---

<nav
  class:list={[
    "relative z-20 px-5 sm:px-8",
    isEditorial ? "-mt-7 sm:-mt-8" : "-mt-10 sm:-mt-12",
  ]}
  aria-label="Ways to explore undergraduate programs"
>
  <div
    class:list={[
      "mx-auto grid grid-cols-3 overflow-hidden bg-white",
      isEditorial
        ? "max-w-4xl border-b border-slate-300 shadow-lg shadow-primary-950/10"
        : "max-w-5xl border border-slate-400 shadow-xl shadow-primary-950/10",
    ]}
  >
    {
      views.map((view, index) => {
        const isActive = active === view.id;
        return (
          <a
            href={view.href}
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "group relative flex flex-col items-center justify-center px-2 text-center no-underline transition sm:px-5",
              isEditorial ? "min-h-16 py-3 sm:min-h-20" : "min-h-20 py-4 sm:min-h-24",
              index > 0 &&
                (isEditorial ? "border-l border-slate-300" : "border-l border-slate-400"),
              isEditorial
                ? isActive
                  ? "bg-white text-primary-950"
                  : "bg-white text-primary-950 hover:bg-tertiary-100"
                : isActive
                  ? "bg-primary-900 text-white"
                  : "bg-white text-primary-950 hover:bg-tertiary-100",
            ]}
          >
            {isActive && (
              <span
                class:list={[
                  "absolute inset-x-0 bg-[#f2bd55]",
                  isEditorial ? "bottom-0 h-1.5" : "top-0 h-1",
                ]}
                aria-hidden="true"
              />
            )}
            <span
              class:list={[
                "hidden text-[9px] font-extrabold uppercase tracking-[.13em] sm:block",
                isActive && !isEditorial
                  ? "text-[#f2bd55]"
                  : "text-slate-500 group-hover:text-primary-700",
              ]}
            >
              {view.eyebrow}
            </span>
            <span class="font-title text-sm font-bold leading-tight sm:mt-1 sm:text-lg lg:text-xl">
              {view.label}
            </span>
            {isActive && <span class="sr-only"> (current page)</span>}
          </a>
        );
      })
    }
  </div>
</nav>
