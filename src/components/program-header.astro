---
import type { HTMLAttributes } from "astro/types";
import { cn } from "../lib/utils";
import Icon from "./icon.astro";
import SavedProgramsDrawer from "../views/majors-minors/saved-programs-drawer.astro";

interface Props extends HTMLAttributes<"section"> {
  title: string;
  description: string;
}

const { title, description, class: className, ...props } = Astro.props;
---

<section
  x-data="{ id: document.querySelector('meta[name=id]').content }"
  class={cn("wrapper pt-12 md:pt-24 relative", className)}
  {...props}
>
  <h2 class="mb-4 font-title text-3xl lg:text-4xl text-primary-800 md:w-2/3">
    {title}
  </h2>
  <p class="font-title leading-tight text-xl md:text-2xl md:w-1/2 lg:w-2/3 text-tertiary-500">
    {description}
  </p>

  <div class="flex gap-2 items-center" x-cloak>
    <button type="button" class="btn btn-quaternary mt-4" x-show="!$store.bookmarks.has(id)" @click="$store.bookmarks.add(id)">
      <Icon name="bookmark" class="size-5" />
      Save this program
    </button>
  
    <button type="button" class="btn btn-quaternary mt-4" x-show="$store.bookmarks.has(id)" title="Remove from bookmarks" @click="$store.bookmarks.remove(id)">
      <Icon name="bookmark-slash" class="size-5" />
    </button>
  
    <button type="button" class="btn btn-quaternary mt-4" x-show="$store.bookmarks.has(id)" @click="$dispatch('opensavedprograms')">
      View saved programs
      <Icon name="chevron-right" class="size-5" />
    </button>
  </div>

  <SavedProgramsDrawer />

  <slot />
</section>