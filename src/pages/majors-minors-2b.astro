---
import "../styles/program-discovery.css";
import BaseLayout from "../layouts/base.astro";
import ProgramCard from "../views/majors-minors-new/program-card.astro";
import Icon from "../components/icon.astro";
import KeepExploring from "../views/majors-minors-new/keep-exploring.astro";
import TabNavigation from "../views/majors-minors-new/tab-navigation.astro";
import Footer from "../views/majors-minors-new/footer.astro";
import Hero from "../views/majors-minors-new/hero.astro";
---

<BaseLayout
  title="Majors, Minors and Programs"
  description="Find a Messiah University undergraduate major, minor, concentration or accelerated program that fits your interests and goals."
>
  <div class="program-discovery" x-data="programExplorer()">
    <Hero
      eyebrow="Majors, minors, and programs"
      title="Undergraduate programs"
      imageUrl="https://www.messiah.edu/undergraduate/interest-area/science-health-the-natural-world/_images/science.webp"
    >
      Explore <a
        href="#program-finder"
        @click.prevent="goToType('major')"
        class="font-bold underline decoration-mango-300 decoration-2 underline-offset-4 hover:text-white"
        >80+ majors</a
      >, plus <a
        href="#program-finder"
        @click.prevent="goToType('accelerated')"
        class="font-bold underline decoration-mango-300 decoration-2 underline-offset-4 hover:text-white"
        >accelerated and seamless pathway programs</a
      > designed to help you reach your goals.
    </Hero>

    <main id="content">
      <TabNavigation active="az" />

      <section id="program-finder" class="discovery-section" aria-live="polite">
        <div class="discovery-container">
          <div class="mb-10">
            <div>
              <h2 class="discovery-heading">Build your shortlist.</h2>
              <p class="discovery-intro">
                Search the complete undergraduate catalog. Save the programs that stand out, then
                come back when you’re ready to compare.
              </p>
            </div>
          </div>

          <form @submit.prevent class="border border-slate-300 bg-white">
            <div class="grid lg:grid-cols-[1.6fr_.8fr]">
              <label
                class="relative flex min-h-20 items-center border-b border-slate-300 lg:border-b-0 lg:border-r"
              >
                <span class="sr-only">Search programs</span>
                <Icon name="search" class="ml-6 size-6 shrink-0 text-primary-700" />
                <input
                  x-model.debounce.200ms="query"
                  @input="shownCount = pageSize; syncUrl()"
                  type="search"
                  autocomplete="off"
                  placeholder="Search a program, interest, or career"
                  class="min-w-0 flex-1 border-0 px-4 py-6 text-base outline-none focus:ring-0 sm:text-lg"
                />
                <button
                  x-show="query"
                  x-cloak
                  type="button"
                  @click="query = ''; shownCount = pageSize; syncUrl()"
                  class="mr-5 grid size-11 place-items-center rounded-full bg-slate-100 text-slate-500"
                  aria-label="Clear search"><Icon name="close" class="size-4" /></button
                >
              </label>
              <label class="px-6 py-3">
                <span class="block text-xs font-extrabold uppercase tracking-[.12em] text-slate-500"
                  >Interest area</span
                >
                <select
                  x-model="interest"
                  @change="shownCount = pageSize; syncUrl()"
                  class="select mt-1 w-full border-0 bg-transparent px-0 py-2 font-bold text-primary-900 outline-none focus:ring-0"
                >
                  <option value="">All interest areas</option>
                  <template x-for="option in availableInterests" :key="option">
                    <option :value="option" x-text="option"></option>
                  </template>
                </select>
              </label>
            </div>

            <div class="flex flex-wrap gap-2 border-t border-slate-300 bg-slate-50 px-5 py-4">
              <button
                type="button"
                @click="setType('')"
                :aria-pressed="type === ''"
                :class="type === '' ? 'border-primary-900 bg-primary-900 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-primary-700'"
                class="min-h-11 shrink-0 rounded-full border px-4 py-2 text-xs font-bold transition-colors"
                >All programs</button
              >
              <template x-for="option in types" :key="option.key">
                <button
                  type="button"
                  @click="setType(option.key)"
                  :aria-pressed="type === option.key"
                  :class="type === option.key ? 'border-primary-900 bg-primary-900 text-white' : 'border-slate-300 bg-white text-slate-600 hover:border-primary-700'"
                  class="min-h-11 shrink-0 rounded-full border px-4 py-2 text-xs font-bold transition-colors"
                  x-text="option.filterLabel || option.label"></button>
              </template>
            </div>
          </form>

          <div
            class="flex min-h-24 flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between"
          >
            <p class="text-sm text-slate-500" x-show="!loading && !error">
              <strong class="font-title text-2xl text-primary-900" x-text="filteredPrograms.length"
              ></strong>
              <span x-text="filteredPrograms.length === 1 ? ' program' : ' programs'"></span>
              <span x-show="hasFilters"> match your filters</span>
              <button
                x-show="hasFilters"
                type="button"
                @click="resetFilters()"
                class="ml-3 font-bold text-primary-700 underline">Reset</button
              >
            </p>

            <div class="flex flex-wrap items-center gap-4">
              <button
                type="button"
                @click="toggleSavedOnly()"
                :aria-pressed="savedOnly"
                :class="savedOnly ? 'text-primary-700' : 'text-primary-900'"
                class="inline-flex items-center gap-2 text-sm font-bold"
              >
                <Icon
                  name="bookmark"
                  class="size-5"
                  :class="savedOnly ? 'fill-current' : ''"
                  aria-hidden="true"
                />
                Saved
                <span
                  class="grid min-w-6 place-items-center rounded-full bg-primary-900 px-1.5 py-1 text-xs text-white"
                  x-text="$store.bookmarks.count"></span>
              </button>
              <div class="inline-flex border border-slate-200 bg-white" aria-label="Results layout">
                <button
                  type="button"
                  @click="setLayout('cards')"
                  :aria-pressed="layout === 'cards'"
                  :class="layout === 'cards' ? 'bg-primary-900 text-white' : 'text-slate-500'"
                  class="grid size-11 place-items-center"
                  aria-label="Card view"><Icon name="grid" class="size-4" /></button
                >
                <button
                  type="button"
                  @click="setLayout('list')"
                  :aria-pressed="layout === 'list'"
                  :class="layout === 'list' ? 'bg-primary-900 text-white' : 'text-slate-500'"
                  class="grid size-11 place-items-center"
                  aria-label="List view"><Icon name="list" class="size-4" /></button
                >
              </div>
            </div>
          </div>

          <div
            x-show="loading"
            class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"
            aria-label="Loading programs"
          >
            {
              [1, 2, 3, 4, 5, 6].map(() => (
                <div class="animate-pulse border border-slate-200 bg-white">
                  <div class="h-40 bg-slate-200" />
                  <div class="space-y-4 p-6">
                    <>
                      <div class="h-7 w-2/3 bg-slate-200" />
                      <div class="h-4 w-full bg-slate-100" />
                      <div class="h-4 w-4/5 bg-slate-100" />
                    </>
                  </div>
                </div>
              ))
            }
          </div>

          <div x-show="error" x-cloak role="alert" class="discovery-error">
            <h3 class="font-title text-2xl font-bold text-primary-900">
              We couldn’t load the program list.
            </h3>
            <p class="mt-2 text-slate-600" x-text="error"></p>
            <button
              type="button"
              @click="loadPrograms()"
              class="mt-4 font-bold text-primary-800 underline">Try again</button
            >
          </div>

          <div
            x-show="!loading && !error && filteredPrograms.length === 0"
            x-cloak
            class="border border-slate-200 bg-white px-6 py-20 text-center"
          >
            <Icon name="search" class="mx-auto size-10 text-primary-700" />
            <h3 class="mt-4 font-title text-3xl font-bold text-primary-900">
              No exact matches—yet.
            </h3>
            <p class="mx-auto mt-2 max-w-xl text-slate-600">
              Try a broader term like “health,” “business,” or “helping people,” or clear a filter.
            </p>
            <button
              type="button"
              @click="resetFilters()"
              class="mt-5 bg-mango-300 px-6 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-950"
              >See all programs</button
            >
          </div>

          <div
            x-show="!loading && !error && filteredPrograms.length > 0 && layout === 'cards'"
            x-cloak
            class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"
          >
            <template x-for="program in visiblePrograms" :key="program.entry_id">
              <div class="contents">
                <template x-if="program._searchGroupStart">
                  <h3
                    class="col-span-full font-title text-3xl font-bold text-primary-950"
                    :class="program._searchGroupStart === 'related' ? 'mt-8' : ''"
                  >
                    <span
                      x-text="program._searchGroupStart === 'direct' ? 'Programs directly related to' : 'Program related to'"
                    ></span>
                    “<span x-text="query.trim()"></span>”
                  </h3>
                </template>

                <ProgramCard filterInterests />
              </div>
            </template>
          </div>

          <div
            x-show="!loading && !error && filteredPrograms.length > 0 && layout === 'list'"
            x-cloak
            class="grid gap-3"
          >
            <template x-for="program in visiblePrograms" :key="`list-${program.entry_id}`">
              <div class="contents">
                <template x-if="program._searchGroupStart">
                  <h3
                    class="font-title text-3xl font-bold text-primary-950"
                    :class="program._searchGroupStart === 'related' ? 'mt-8' : ''"
                  >
                    <span
                      x-text="program._searchGroupStart === 'direct' ? 'Programs directly related to' : 'Program related to'"
                    ></span>
                    “<span x-text="query.trim()"></span>”
                  </h3>
                </template>
                <article class="group border border-slate-300 bg-white">
                  <div
                    class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-6 lg:px-6"
                  >
                    <div>
                      <div
                        class="mb-2 flex flex-wrap gap-2 text-xs font-bold uppercase tracking-widest text-slate-500"
                        x-text="programTypes(program).map((program) => program.label).join(', ')"
                      >
                      </div>

                      <h3
                        class="flex flex-wrap items-center gap-x-3 gap-y-2 font-title text-3xl font-bold text-primary-950"
                      >
                        <a :href="programUrl(program)" x-text="program.program_name"></a>
                        <template x-for="degree in degrees(program)" :key="degree">
                          <span
                            class="inline-flex shrink-0 items-center bg-primary-900 px-2.5 py-1.5 font-sans text-xs font-extrabold uppercase leading-none tracking-[.08em] text-white"
                            x-text="degree"></span>
                        </template>
                      </h3>
                    </div>
                    <div
                      class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-slate-200 pt-4 lg:flex-nowrap lg:justify-end lg:border-t-0 lg:pl-6 lg:pt-0"
                    >
                      <button
                        type="button"
                        @click="showDetails(program)"
                        class="inline-flex items-center gap-2 whitespace-nowrap text-xs font-extrabold uppercase tracking-wider text-primary-900"
                      >
                        Quick view
                        <Icon name="expand" class="size-5 text-mango-300" />
                      </button>
                      <button
                        type="button"
                        @click="$store.bookmarks.toggle(program.entry_id)"
                        class="inline-flex items-center gap-2 whitespace-nowrap text-xs font-extrabold uppercase tracking-wider text-primary-900"
                      >
                        <span
                          x-text="$store.bookmarks.has(program.entry_id) ? 'Saved' : 'Save program'"
                        ></span>
                        <Icon
                          name="bookmark"
                          class="size-5"
                          :class="$store.bookmarks.has(program.entry_id) ? 'fill-mango-300' : ''"
                          aria-hidden="true"
                        />
                      </button>
                    </div>
                  </div>
                </article>
              </div>
            </template>
          </div>

          <div
            x-ref="loadMoreSentinel"
            x-show="filteredPrograms.length > visiblePrograms.length"
            x-cloak
            class="mt-10 flex min-h-16 items-center justify-center text-center"
            aria-live="polite"
          >
            <template x-if="autoLoadSupported">
              <span
                class="inline-flex items-center gap-3 text-xs font-extrabold uppercase tracking-wider text-primary-900"
              >
                <span class="size-2 animate-pulse rounded-full bg-[#bd7d0d]" aria-hidden="true"
                ></span>
                Loading more programs…
              </span>
            </template>
            <template x-if="!autoLoadSupported">
              <button
                type="button"
                @click="shownCount += pageSize"
                class="min-w-64 border border-primary-900 px-6 py-4 text-xs font-extrabold uppercase tracking-wider text-primary-900 transition hover:bg-primary-900 hover:text-white"
                >Load more programs <span class="ml-2">↓</span></button
              >
            </template>
          </div>
        </div>
      </section>

      <KeepExploring active="az" />

      <Footer />
    </main>

    <template x-teleport="body">
      <div
        x-show="openProgram"
        x-cloak
        @keydown.escape.window="closeDetails()"
        class="program-discovery fixed inset-0 z-[100] flex justify-end bg-primary-950/75"
        role="presentation"
      >
        <button
          type="button"
          @click="closeDetails()"
          class="absolute inset-0 cursor-default"
          aria-label="Close program details"></button>
        <section
          x-show="openProgram"
          x-trap.noscroll.inert="openProgram"
          role="dialog"
          aria-modal="true"
          aria-labelledby="quick-view-title"
          class="relative h-full w-full max-w-2xl overflow-y-auto bg-white shadow-2xl"
        >
          <button
            type="button"
            @click="closeDetails()"
            class="absolute right-4 top-4 z-10 grid size-11 place-items-center rounded-full bg-white text-primary-900 shadow-md hover:bg-mango-300"
            aria-label="Close program details"><Icon name="close" class="size-7" /></button
          >
          <div class="relative h-64 bg-primary-900">
            <img
              :src="openProgram?.thumbnail_small"
              :alt="openProgram?.thumbnail_small_alt || ''"
              class="h-full w-full object-cover"
            /><span class="absolute inset-0 bg-gradient-to-r from-primary-950/70 to-transparent"
            ></span><span
              class="absolute bottom-6 left-7 text-xs font-extrabold uppercase tracking-[.16em] text-white"
              x-text="openProgram?.department_name"></span>
          </div>
          <div class="p-6 sm:p-10">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="mb-2 text-xs font-extrabold uppercase tracking-[.12em] text-primary-700">
                  Undergraduate program
                </p><h2
                  id="quick-view-title"
                  class="font-title text-4xl font-bold leading-none text-primary-950 sm:text-5xl"
                  x-text="openProgram?.program_name"
                >
                </h2>
              </div><div class="flex flex-wrap gap-2">
                <template x-for="degree in degrees(openProgram)" :key="degree"
                  ><span
                    class="border border-slate-300 bg-white px-3 py-2 font-title text-sm font-bold text-primary-900"
                    x-text="degree"></span></template
                >
              </div>
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              <template x-for="programType in programTypes(openProgram)" :key="programType.key"
                ><span
                  class="rounded-full bg-primary-900 px-3 py-2 text-xs font-bold text-white"
                  x-text="programType.label"></span></template
              >
            </div>
            <p
              class="mt-7 font-title text-lg leading-relaxed text-slate-700"
              x-text="openProgram?.program_peek || 'Explore this program’s curriculum, learning opportunities and career preparation.'"
            >
            </p>
            <div
              x-show="careerItems(openProgram).length"
              class="mt-8 border border-mango-200 bg-mango-50 p-6"
            >
              <h3 class="font-title text-xl font-bold text-primary-900">
                Where this program can lead
              </h3><div class="mt-3 flex flex-wrap gap-2">
                <template x-for="career in careerItems(openProgram).slice(0, 8)" :key="career"
                  ><span class="bg-white px-2.5 py-2 text-xs text-primary-700" x-text="career"
                  ></span></template
                >
              </div>
            </div>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                :href="programUrl(openProgram)"
                class="inline-flex min-h-12 items-center gap-3 bg-mango-300 px-6 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-950 no-underline"
                >Explore full program <span class="text-lg">→</span></a
              ><button
                type="button"
                @click="$store.bookmarks.toggle(openProgram.entry_id)"
                class="inline-flex min-h-12 items-center gap-3 border border-slate-300 bg-white px-6 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-900"
                ><Icon name="bookmark" class="size-5" /><span
                  x-text="$store.bookmarks.has(openProgram?.entry_id) ? 'Program saved' : 'Save program'"
                ></span></button
              >
            </div>
            <div x-show="relatedPrograms.length" class="mt-12 border-t border-slate-200 pt-8">
              <p class="mb-2 text-xs font-extrabold uppercase tracking-[.14em] text-primary-700">
                Keep exploring
              </p><h3 class="font-title text-3xl font-bold text-primary-900">
                Related programs
              </h3><div class="mt-5 grid gap-3 sm:grid-cols-3">
                <template x-for="related in relatedPrograms" :key="related.entry_id"
                  ><button
                    type="button"
                    @click="showDetails(related)"
                    class="border border-slate-200 bg-white p-4 text-left"
                    ><span
                      class="text-xs font-bold uppercase text-slate-500"
                      x-text="related.department_name"></span><span
                      class="mt-1 block font-title text-lg font-bold leading-tight text-primary-900"
                      x-text="related.program_name"></span><span
                      class="mt-4 block text-xs font-extrabold uppercase text-primary-700"
                      >QUICK VIEW →</span
                    ></button
                  ></template
                >
              </div>
            </div>
          </div>
        </section>
      </div>
    </template>
  </div>

  <script is:inline>
    function programExplorer() {
      return {
        programs: [],
        loading: true,
        error: "",
        query: "",
        type: "",
        interest: "",
        savedOnly: false,
        layout: "cards",
        shownCount: 24,
        pageSize: 24,
        autoLoadSupported: "IntersectionObserver" in window,
        loadMoreObserver: null,
        openProgram: null,
        types: [
          { key: "major", label: "Major", filterLabel: "Majors" },
          { key: "minor", label: "Minor", filterLabel: "Minors" },
          { key: "concentration", label: "Concentration", filterLabel: "Concentrations" },
          { key: "pre_health", label: "Pre-health advising", filterLabel: "Pre-health" },
          { key: "teaching_certification", label: "Teaching certification" },
          { key: "accelerated", label: "Accelerated" },
          {
            key: "partner_program",
            label: "3+ partner program",
            filterLabel: "3+ partner programs",
          },
          { key: "early_assurance", label: "Early assurance" },
          {
            key: "undergrad_certificate",
            label: "Undergraduate certificate",
            filterLabel: "Certificates",
          },
        ],
        init() {
          let params = new URLSearchParams(location.search);

          this.query = params.get("search") || "";
          this.type = params.get("type") || "";
          this.interest = params.get("interest") || "";

          try {
            let saved = localStorage.getItem("ug-program-layout-2b");

            if (["cards", "list"].includes(saved)) {
              this.layout = saved;
            }
          } catch {}

          this.loadPrograms();
        },

        async loadPrograms() {
          this.loading = true;
          this.error = "";

          try {
            let response = await fetch(
              "https://cascade-prod.messiah.edu/_program_data/ug-json.json",
            );

            if (!response.ok) {
              throw new Error(`The server returned ${response.status}.`);
            }

            let data = await response.json();

            this.programs = (data.items || [])
              .filter((program) => program.hide_on_program_listing !== "yes")
              .sort((a, b) => (a.program_name || "").localeCompare(b.program_name || ""));

            this.$store.bookmarks.keepOnly(this.programs.map((program) => program.entry_id));
          } catch (error) {
            this.error = error instanceof Error ? error.message : "Please try again in a moment.";
          } finally {
            this.loading = false;
            this.$nextTick(() => this.setupInfiniteScroll());
          }
        },

        setupInfiniteScroll() {
          this.loadMoreObserver?.disconnect();

          if (!this.autoLoadSupported || !this.$refs.loadMoreSentinel) {
            return;
          }

          this.loadMoreObserver = new IntersectionObserver(
            ([entry]) => {
              if (
                entry?.isIntersecting &&
                this.filteredPrograms.length > this.visiblePrograms.length
              ) {
                this.shownCount += this.pageSize;
              }
            },
            { rootMargin: "400px 0px" },
          );

          this.loadMoreObserver.observe(this.$refs.loadMoreSentinel);
        },

        destroy() {
          this.loadMoreObserver?.disconnect();
        },

        get availableInterests() {
          return [...new Set(this.programs.flatMap(this.interestTags))].filter(Boolean).sort();
        },

        get filteredPrograms() {
          let terms = this.query.trim().toLowerCase().split(/\s+/).filter(Boolean);
          let matches = this.programs.filter((program) => {
            let haystack = [program.program_name, program.keywords]
              .filter(Boolean)
              .join(" ")
              .toLowerCase();

            return (
              terms.every((term) => haystack.includes(term)) &&
              (!this.type || program[this.type] === "true") &&
              (!this.interest || this.interestTags(program).includes(this.interest)) &&
              (!this.savedOnly || this.$store.bookmarks.has(program.entry_id))
            );
          });

          return matches.sort((a, b) => a.program_name.localeCompare(b.program_name));
        },

        get directSearchPrograms() {
          let query = this.query.trim().toLowerCase();

          if (!query) {
            return this.filteredPrograms;
          }

          return this.filteredPrograms.filter((program) =>
            (program.program_name || "").toLowerCase().includes(query),
          );
        },

        get keywordSearchPrograms() {
          if (!this.query.trim()) {
            return [];
          }

          let directIds = new Set(this.directSearchPrograms.map((program) => program.entry_id));

          return this.filteredPrograms.filter((program) => !directIds.has(program.entry_id));
        },

        get visiblePrograms() {
          if (!this.query.trim()) {
            return this.filteredPrograms.slice(0, this.shownCount);
          }

          let direct = this.directSearchPrograms
            .slice(0, this.shownCount)
            .map((program, index) => ({
              ...program,
              _searchGroupStart: index === 0 ? "direct" : "",
            }));
          let remaining = Math.max(0, this.shownCount - direct.length);
          let related = this.keywordSearchPrograms.slice(0, remaining).map((program, index) => ({
            ...program,
            _searchGroupStart: index === 0 ? "related" : "",
          }));

          return [...direct, ...related];
        },

        get hasFilters() {
          return Boolean(this.query || this.type || this.interest || this.savedOnly);
        },

        get relatedPrograms() {
          if (!this.openProgram?.related_programs) {
            return [];
          }

          return this.openProgram.related_programs
            .split("|")
            .map((id) => this.programs.find((program) => program.entry_id === id))
            .filter(Boolean)
            .slice(0, 3);
        },

        setType(value) {
          this.type = value;
          this.shownCount = this.pageSize;
          this.syncUrl();
        },

        goToType(value) {
          this.setType(value);
          this.$nextTick(() =>
            document.getElementById("program-finder")?.scrollIntoView({
              behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
                ? "instant"
                : "smooth",
            }),
          );
        },

        setLayout(value) {
          this.layout = value === "list" ? "list" : "cards";

          try {
            localStorage.setItem("ug-program-layout-2b", this.layout);
          } catch {}
        },

        chooseInterest(value) {
          this.interest = value;
          this.shownCount = this.pageSize;
          this.syncUrl();
          this.$nextTick(() =>
            document.getElementById("program-finder")?.scrollIntoView({
              behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
                ? "instant"
                : "smooth",
            }),
          );
        },

        goToFinder() {
          this.syncUrl();
          document.getElementById("program-finder")?.scrollIntoView({
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "instant"
              : "smooth",
          });
        },

        toggleSavedOnly() {
          this.savedOnly = !this.savedOnly;
          this.query = "";
          this.type = "";
          this.interest = "";
          this.shownCount = this.pageSize;
          this.syncUrl();
        },

        resetFilters() {
          this.query = "";
          this.type = "";
          this.interest = "";
          this.savedOnly = false;
          this.shownCount = this.pageSize;
          this.syncUrl();
        },

        syncUrl() {
          let url = new URL(window.location.href);

          ["search", "type", "interest"].forEach((key) => url.searchParams.delete(key));

          if (this.query) url.searchParams.set("search", this.query);
          if (this.type) url.searchParams.set("type", this.type);
          if (this.interest) url.searchParams.set("interest", this.interest);

          window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
        },
        showDetails(program) {
          this.openProgram = program;
        },

        closeDetails() {
          this.openProgram = null;
        },

        programUrl(program) {
          let path = String(program?.program_url || program?.url_slug || "").replace(/^\/+/, "");

          return path ? `/${path}` : "#";
        },

        degrees(program) {
          if (!program?.degree || program.degree === "none") {
            return [];
          }

          return program.degree.split("|").filter(Boolean);
        },

        programTypes(program) {
          if (!program) {
            return [];
          }

          return this.types.filter((item) => program[item.key] === "true");
        },

        interestTags(program) {
          return (program?.interest_group_name || "")
            .split("|")
            .map((tag) => tag.trim())
            .filter(Boolean);
        },

        careerItems(program) {
          return (program?.job_title || "")
            .split(/,|\r?\n/)
            .map((item) => item.trim())
            .filter(Boolean);
        },
      };
    }
  </script>
</BaseLayout>
