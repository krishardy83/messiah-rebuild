---
import BaseLayout from "../layouts/base.astro";
import ProgramDiscoveryNav from "../components/program-discovery-nav.astro";

const interestAreas = [
  {
    title: "Art and Design",
    url: "https://www.messiah.edu/undergraduate/interest-area/art-and-performing-art/index",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/musicaltheatre_hero.jpg",
  },
  {
    title: "Business, Leadership and Innovation",
    url: "https://www.messiah.edu/undergraduate/interest-area/business/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/mobile/business_administration_b.s.jpg",
  },
  {
    title: "Communication and Media",
    url: "https://www.messiah.edu/undergraduate/interest-area/communication-and-media/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/communications_hero.jpg",
  },
  {
    title: "Education and Teaching",
    url: "https://www.messiah.edu/undergraduate/interest-area/education-teaching/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/early_childhood_ed_hero.jpg",
  },
  {
    title: "Engineering and Innovation",
    url: "https://www.messiah.edu/undergraduate/interest-area/engineering/",
    image:
      "https://www.messiah.edu/undergraduate/interest-area/engineering/_images/engineering-3.webp",
  },
  {
    title: "Finance, Analytics and Mathematics",
    url: "https://www.messiah.edu/undergraduate/interest-area/finance-analytics-mathematics/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/finance_hero1.jpg",
  },
  {
    title: "Government and Law",
    url: "https://www.messiah.edu/undergraduate/interest-area/politics-history-and-public-service/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/politics_hero.jpg",
  },
  {
    title: "Health, Science and Human Services",
    url: "https://www.messiah.edu/undergraduate/interest-area/health-science-human-services/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/nutritionanddietetics_hero_1.jpg",
  },
  {
    title: "History, Politics and Culture",
    url: "https://www.messiah.edu/undergraduate/interest-area/history-politics-culture/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/aareligion.jpg",
  },
  {
    title: "Human Behavior and Society",
    url: "https://www.messiah.edu/undergraduate/interest-area/human-behavior-society-community-care/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/children_and_youth_services_hero.jpg",
  },
  {
    title: "Language",
    url: "https://www.messiah.edu/undergraduate/interest-area/language/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/chinesestudies_1.jpg",
  },
  {
    title: "Faith, Ministry and Christian Leadership",
    url: "https://www.messiah.edu/undergraduate/interest-area/ministry/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/cross_cultural_ministries_hero.jpg",
  },
  {
    title: "Music and Theatre",
    url: "https://www.messiah.edu/undergraduate/interest-area/music-theatre-performing-arts/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/music_4.jpg",
  },
  {
    title: "Science, Health and the Natural World",
    url: "https://www.messiah.edu/undergraduate/interest-area/science-health-the-natural-world/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/nutritionanddietetics_hero_1.jpg",
  },
  {
    title: "Sustainability and Environment",
    url: "https://www.messiah.edu/undergraduate/interest-area/sustainability-environment-community/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/sustainability_studies_major.jpg",
  },
  {
    title: "Technology, Computing and Data",
    url: "https://www.messiah.edu/undergraduate/interest-area/technology-computing-data/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/cybersecurity_hero.jpg",
  },
];
---

<BaseLayout
  title="Undergraduate Programs by Interest"
  description="Explore Messiah University undergraduate majors, minors and programs grouped by interest and career areas."
>
  <main id="content" class="bg-white text-slate-800">
    <section
      class="relative isolate -mt-32 min-h-[650px] overflow-hidden bg-primary-950 text-white lg:min-h-[720px] xl:min-h-[760px]"
    >
      <img
        src="/images/program-explorer-graduate-hero.png"
        alt=""
        class="absolute inset-0 -z-30 h-full w-full object-cover object-top"
        aria-hidden="true"
      />
      <div
        class="absolute inset-0 -z-20"
        style="background: linear-gradient(90deg, rgba(13, 35, 61, 0.98) 0%, rgba(13, 35, 61, 0.9) 36%, rgba(13, 35, 61, 0.48) 68%, rgba(13, 35, 61, 0.08) 100%);"
      >
      </div>

      <div
        class="mx-auto flex min-h-[650px] max-w-7xl items-center px-5 pb-24 pt-44 sm:px-8 lg:min-h-[720px] lg:pb-28 xl:min-h-[760px]"
      >
        <div class="w-full max-w-4xl">
          <p class="mb-5 text-xs font-extrabold uppercase tracking-[.2em] text-[#f2bd55]">
            Majors, minors, and programs
          </p>
          <h1
            class="font-title text-5xl font-bold leading-[.92] tracking-[-.035em] sm:text-6xl lg:text-7xl xl:text-8xl"
          >
            Program Explorer
          </h1>
          <p class="mt-7 max-w-xl font-title text-2xl leading-relaxed text-white/85 lg:text-3xl">
            Start with what interests you and discover academic paths that turn curiosity into
            meaningful work and a life of purpose.
          </p>
        </div>
      </div>
    </section>

    <ProgramDiscoveryNav active="interest" />

    <section id="interest-areas" class="scroll-mt-20 bg-white py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="mb-12 max-w-4xl">
          <p class="mb-3 text-xs font-extrabold uppercase tracking-[.2em] text-primary-700">
            Browse by interest
          </p>
          <h2
            class="font-title text-4xl font-bold leading-none tracking-tight text-primary-950 sm:text-5xl lg:text-6xl"
          >
            Find a direction that feels like you.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-slate-600 sm:text-lg">
            View academic programs grouped by interest and career areas. Choose a category to
            explore the majors, minors and pathways connected to it.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            interestAreas.map((interest) => (
              <article class="group relative flex min-h-full flex-col overflow-hidden border border-slate-400 bg-white transition duration-200 hover:-translate-y-1 hover:border-primary-300 hover:shadow-xl">
                <div class="aspect-[16/7] overflow-hidden bg-slate-200">
                  <img
                    src={interest.image}
                    alt=""
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width="580"
                    height="254"
                  />
                </div>
                <div class="flex flex-1 items-end justify-between gap-6 p-6">
                  <div>
                    <p class="mb-2 text-xs font-bold text-slate-500">I'm interested in</p>
                    <h3 class="font-title text-3xl font-bold leading-none text-primary-900">
                      <a
                        href={interest.url}
                        class="after:absolute after:inset-0 hover:underline hover:decoration-[#f2bd55] hover:decoration-4"
                      >
                        {interest.title}
                      </a>
                    </h3>
                  </div>
                  <span
                    class="shrink-0 text-2xl text-[#bd7d0d] transition-transform group-hover:translate-x-1"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </div>
              </article>
            ))
          }
        </div>

        <div class="mt-12 border-t border-slate-200 pt-8 text-center">
          <p class="text-slate-600">Already know what you’re looking for?</p>
          <a
            href="/majors-minors-2b/"
            class="mt-4 inline-flex min-h-12 items-center justify-center border border-primary-900 px-6 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-900 no-underline transition hover:bg-primary-900 hover:text-white"
            >View all programs A–Z <span class="ml-3" aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </section>

    <section
      id="next-steps"
      class="scroll-mt-20 bg-gradient-to-r from-[#11698c] to-[#0b7367] py-16 text-white"
      aria-labelledby="next-steps-title"
    >
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.18em] text-white">Your next step</p>
          <h2 id="next-steps-title" class="mt-3 font-title text-4xl leading-tight md:text-5xl">
            See where a Messiah education could take you.
          </h2>
          <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap">
            <a
              class="inline-flex min-h-12 items-center justify-center rounded-sm bg-[#e5ae3a] px-5 py-3 font-bold text-primary-900 transition hover:-translate-y-0.5 hover:bg-[#d59e2b]"
              href="/visit">Plan a visit</a
            >
            <a
              class="inline-flex min-h-12 items-center justify-center rounded-sm border border-white/80 px-5 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:bg-white hover:text-primary-800"
              href="https://www.messiah.edu/applytoday">Apply to Messiah</a
            >
            <a
              class="inline-flex min-h-12 items-center justify-center rounded-sm border border-white/80 px-5 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:bg-white hover:text-primary-800"
              href="https://www.messiah.edu/ug-tuition-and-aid/">Tuition</a
            >
            <a
              class="inline-flex min-h-12 items-center justify-center rounded-sm border border-white/80 px-5 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:bg-white hover:text-primary-800"
              href="https://www.messiah.edu/ug-fin-aid/">Scholarships</a
            >
          </div>
        </div>

        <form
          data-analytics="request-information"
          method="GET"
          action="https://www.messiah.edu/undergraduate-admissions/request-more-information/request-information"
          class="mt-10 grid gap-6 border-t border-white/30 pt-8 lg:grid-cols-[13rem_minmax(0,1fr)] lg:items-end lg:gap-8"
        >
          <div class="self-center">
            <p class="text-xs font-bold uppercase tracking-[.18em] text-tertiary-200">
              Tell us about yourself
            </p>
            <h3 class="mt-2 font-title text-2xl font-bold uppercase text-white">
              Request information
            </h3>
          </div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1.2fr_auto]">
            <div>
              <label for="interest-rfi-first-name" class="sr-only">First name</label>
              <input
                id="interest-rfi-first-name"
                type="text"
                name="firstname"
                autocomplete="given-name"
                placeholder="First name"
                required
                class="h-14 w-full border border-transparent bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:border-[#e5ae3a] focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
              />
            </div>
            <div>
              <label for="interest-rfi-last-name" class="sr-only">Last name</label>
              <input
                id="interest-rfi-last-name"
                type="text"
                name="lastname"
                autocomplete="family-name"
                placeholder="Last name"
                required
                class="h-14 w-full border border-transparent bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:border-[#e5ae3a] focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
              />
            </div>
            <div class="sm:col-span-2 lg:col-span-1">
              <label for="interest-rfi-email" class="sr-only">Email</label>
              <input
                id="interest-rfi-email"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="Email"
                required
                class="h-14 w-full border border-transparent bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:border-[#e5ae3a] focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
              />
            </div>
            <button
              type="submit"
              class="inline-flex min-h-14 w-full items-center justify-center border border-white/80 px-6 py-3 font-title font-bold uppercase tracking-wider text-white transition hover:bg-white hover:text-primary-800 focus-visible:bg-white focus-visible:text-primary-800 sm:col-span-2 lg:col-span-1 lg:w-auto"
            >
              Next
            </button>
          </div>
        </form>
      </div>
    </section>
  </main>
</BaseLayout>
