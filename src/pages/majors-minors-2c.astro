---
import "../styles/program-discovery.css";
import BaseLayout from "../layouts/base.astro";
import Footer from "../views/majors-minors-new/footer.astro";
import Hero from "../views/majors-minors-new/hero.astro";
import KeepExploring from "../views/majors-minors-new/keep-exploring.astro";
import Icon from "../components/icon.astro";
import TabNavigation from "../views/majors-minors-new/tab-navigation.astro";

const interestAreas = [
  {
    title: "Art and Design",
    url: "https://www.messiah.edu/undergraduate/interest-area/art-and-performing-art/index",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/musicaltheatre_hero.jpg",
  },
  {
    title: "Business, Leadership and Innovation",
    url: "https://www.messiah.edu/undergraduate/interest-area/business/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/mobile/business_administration_b.s.jpg",
  },
  {
    title: "Communication and Media",
    url: "https://www.messiah.edu/undergraduate/interest-area/communication-and-media/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/communications_hero.jpg",
  },
  {
    title: "Education and Teaching",
    url: "https://www.messiah.edu/undergraduate/interest-area/education-teaching/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/early_childhood_ed_hero.jpg",
  },
  {
    title: "Engineering and Innovation",
    url: "https://www.messiah.edu/undergraduate/interest-area/engineering/",
    image:
      "https://www.messiah.edu/undergraduate/interest-area/engineering/_images/engineering-3.webp",
  },
  {
    title: "Finance, Analytics and Mathematics",
    url: "https://www.messiah.edu/undergraduate/interest-area/finance-analytics-mathematics/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/finance_hero1.jpg",
  },
  {
    title: "Government and Law",
    url: "https://www.messiah.edu/undergraduate/interest-area/politics-history-and-public-service/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/politics_hero.jpg",
  },
  {
    title: "Health, Science and Human Services",
    url: "https://www.messiah.edu/undergraduate/interest-area/health-science-human-services/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/nutritionanddietetics_hero_1.jpg",
  },
  {
    title: "History, Politics and Culture",
    url: "https://www.messiah.edu/undergraduate/interest-area/history-politics-culture/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/aareligion.jpg",
  },
  {
    title: "Human Behavior and Society",
    url: "https://www.messiah.edu/undergraduate/interest-area/human-behavior-society-community-care/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/children_and_youth_services_hero.jpg",
  },
  {
    title: "Language",
    url: "https://www.messiah.edu/undergraduate/interest-area/language/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/chinesestudies_1.jpg",
  },
  {
    title: "Faith, Ministry and Christian Leadership",
    url: "https://www.messiah.edu/undergraduate/interest-area/ministry/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/cross_cultural_ministries_hero.jpg",
  },
  {
    title: "Music and Theatre",
    url: "https://www.messiah.edu/undergraduate/interest-area/music-theatre-performing-arts/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/music_4.jpg",
  },
  {
    title: "Science, Health and the Natural World",
    url: "https://www.messiah.edu/undergraduate/interest-area/science-health-the-natural-world/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/nutritionanddietetics_hero_1.jpg",
  },
  {
    title: "Sustainability and Environment",
    url: "https://www.messiah.edu/undergraduate/interest-area/sustainability-environment-community/",
    image:
      "https://www.messiah.edu/undergraduate/_images/hero/desktop/sustainability_studies_major.jpg",
  },
  {
    title: "Technology, Computing and Data",
    url: "https://www.messiah.edu/undergraduate/interest-area/technology-computing-data/",
    image: "https://www.messiah.edu/undergraduate/_images/hero/desktop/cybersecurity_hero.jpg",
  },
];
---

<BaseLayout
  title="Undergraduate Programs by Interest"
  description="Explore Messiah University undergraduate majors, minors and programs grouped by interest and career areas."
>
  <div class="program-discovery">
    <Hero
      eyebrow="Browse by interest"
      title="Program explorer"
      imageUrl="/images/program-explorer-graduate-hero.png"
    >
      Start with what interests you and discover academic paths that turn curiosity into meaningful
      work and a life of purpose.
    </Hero>

    <main id="content">
      <TabNavigation active="interest" />

      <section id="interest-areas" class="discovery-section">
        <div class="discovery-container">
          <h2 class="discovery-heading">Find a direction that feels like you.</h2>
          <p class="discovery-intro mb-10">
            View academic programs grouped by interest and career areas. Choose a category to
            explore the majors, minors and pathways connected to it.
          </p>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
              interestAreas.map((interest) => (
                <article class="discovery-card group">
                  <img
                    src={interest.image}
                    alt=""
                    class="aspect-video w-full object-cover bg-slate-200"
                    loading="lazy"
                    decoding="async"
                    width="580"
                    height="326"
                  />

                  <div class="flex flex-col flex-1 p-6 pr-12">
                    <p class="mb-2 text-xs font-bold uppercase tracking-widest text-slate-500">
                      I'm interested in
                    </p>
                    <h3 class="font-title text-3xl font-bold leading-tight text-primary-950">
                      <a
                        href={interest.url}
                        class="after:absolute after:inset-0 hover:underline hover:decoration-mango-300 hover:decoration-4"
                      >
                        {interest.title}
                      </a>
                    </h3>

                    <Icon
                      name="chevron-right"
                      class="absolute bottom-4 right-4 size-6 transition-transform duration-300 group-hover:translate-x-1 text-mango-300"
                    />
                  </div>
                </article>
              ))
            }
          </div>

          <div class="mt-12 border-t border-slate-200 pt-8 text-center">
            <p class="text-slate-600">Already know what you’re looking for?</p>
            <a
              href="/majors-minors-2b/"
              class="mt-4 inline-flex min-h-12 items-center justify-center border border-primary-900 px-6 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-900 no-underline transition hover:bg-primary-900 hover:text-white"
              >View all programs A–Z <span class="ml-3" aria-hidden="true">→</span></a
            >
          </div>
        </div>
      </section>

      <KeepExploring active="interest" />

      <Footer />
    </main>
  </div>
</BaseLayout>
