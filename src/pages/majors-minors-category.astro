---
import BaseLayout from "../layouts/base.astro";
import Icon from "../components/icon.astro";
import Youtube from "../components/youtube.astro";
import ProgramDrawer from "../views/majors-minors-new/program-drawer.astro";
---

<BaseLayout
  programDiscovery
  title="Business, Leadership and Innovation"
  description="Explore business, leadership and innovation programs at Messiah University."
>
  <div x-data="interestAreaPage()" x-init="loadPrograms()">
    <header
      aria-labelledby="category-title"
      class="relative -mt-32 isolate flex min-h-[550px] items-end bg-cover bg-center bg-no-repeat pb-8 pt-40 before:absolute before:inset-0 before:bg-gradient-to-r before:from-primary-700/70 before:to-transparent after:absolute after:inset-0 after:-z-10 after:bg-gradient-to-b after:from-black/60 after:to-transparent md:h-[70vh] md:max-h-[800px] md:items-center md:pb-4"
      style="background-image: url('https://www.messiah.edu/undergraduate/_images/hero/mobile/business_administration_b.s.jpg')"
    >
      <div class="relative z-10 mx-auto w-full max-w-[2100px] px-4 lg:px-12">
        <div class="md:w-1/2">
          <h1 id="category-title" class="h1-md">Business, Leadership and Innovation</h1>
          <hr class="mb-4 mt-3 w-1/2 border-tertiary-300 border-b-4 md:border-b-8" />
          <p
            class="font-title text-xl font-bold uppercase leading-none text-white md:text-2xl lg:text-3xl xl:text-4xl"
          >
            Programs at Messiah
          </p>
        </div>
      </div>
    </header>

    <ul
      class="fixed right-0 top-64 z-20 hidden bg-primary-800 py-1 text-sm uppercase text-white lg:block"
    >
      <li>
        <a class="block px-4 py-1 hover:underline" href="https://www.messiah.edu/applytoday"
          >Apply</a
        >
      </li>
      <li>
        <a class="block px-4 py-1 hover:underline" href="https://www.messiah.edu/visit">Visit</a>
      </li>
      <li>
        <a
          class="block px-4 py-1 hover:underline"
          href="https://www.messiah.edu/office-of-development/">Give</a
        >
      </li>
    </ul>

    <main id="content">
      <section class="pb-6 pt-16 lg:pt-24">
        <div class="mx-auto w-full max-w-7xl px-5 sm:px-8 text-center">
          <h2
            class="font-title text-4xl font-bold leading-tight text-primary-800 sm:text-5xl text-balance max-w-4xl mx-auto mb-4"
          >
            Explore Business, Leadership and Innovation at Messiah University
          </h2>
          <p class="mx-auto max-w-[70ch]">
            Business shapes economies, drives innovation and creates opportunities to serve others.
            At Messiah University, our business and leadership programs prepare students to think
            strategically, lead with integrity and solve real-world problems with confidence.
            Through hands-on projects, internships, close faculty mentorship and a Christ-centered
            perspective, you’ll build practical skills in finance, marketing, technology,
            entrepreneurship and management—equipping you to lead organizations, strengthen
            communities and make wise, ethical decisions in a rapidly changing world.
          </p>
        </div>
      </section>

      <section
        class="scroll-mt-24 bg-white pb-16 pt-8 lg:pb-24 lg:pt-12"
        aria-label="Business program areas"
      >
        <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
          <div
            x-show="loading"
            class="border border-slate-300 bg-slate-50 p-6 text-center text-primary-900"
            role="status"
          >
            Loading programs…
          </div>
          <div
            x-show="error"
            x-cloak
            class="border border-red-200 bg-red-50 p-6 text-red-900"
            role="alert"
          >
            <p class="font-bold">We couldn’t load the program list.</p>
            <p class="mt-1 text-sm">Please try again in a moment.</p>
            <button
              type="button"
              class="mt-2 min-h-11 font-bold underline underline-offset-4"
              @click="loadPrograms()">Try again</button
            >
          </div>

          <div class="grid gap-4" x-show="!loading && !error" x-cloak>
            <p x-show="!groups.length" class="p-6 text-center text-slate-600" role="status">
              No programs are currently listed for this category.
            </p>
            <template x-for="group in groups" x-bind:key="category + ':' + group.id">
              <article
                class="border border-slate-300 bg-white"
                x-data="{ open: false }"
                x-id="['interest-panel']"
              >
                <h3>
                  <button
                    type="button"
                    class="group relative flex min-h-20 w-full items-center gap-4 bg-slate-50 py-4 pl-4 pr-14 text-left text-primary-950 transition-colors hover:bg-primary-50 focus-visible:-outline-offset-4 aria-expanded:bg-primary-50 sm:pl-6"
                    x-bind:aria-controls="$id('interest-panel')"
                    aria-expanded="false"
                    x-bind:aria-expanded="open"
                    x-on:click="open = !open"
                  >
                    <img
                      x-bind:src="group.iconUrl"
                      x-show="group.iconUrl"
                      alt=""
                      aria-hidden="true"
                      width="40"
                      height="40"
                      class="size-10 shrink-0"
                    />
                    <span
                      class="font-title text-xl leading-tight sm:text-2xl"
                      x-html="group.heading"></span>
                    <Icon
                      name="chevron-down"
                      class="absolute right-4 top-1/2 size-5 -translate-y-1/2 text-primary-700 transition-transform group-aria-expanded:rotate-180 sm:right-6"
                      aria-hidden="true"
                    />
                  </button>
                </h3>

                <div
                  x-bind:id="$id('interest-panel')"
                  x-show="open"
                  x-collapse
                  x-cloak
                  class="border-t border-slate-300"
                >
                  <div class="grid">
                    <template x-for="program in group.programs" x-bind:key="program.entry_id">
                      <article class="border-b border-slate-200 last:border-b-0">
                        <div
                          class="grid gap-3 px-4 py-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-8"
                        >
                          <div class="min-w-0">
                            <div
                              class="text-xs font-bold uppercase tracking-wider text-primary-700 mb-2"
                              x-show="programTypes(program).length"
                              x-text="programTypes(program).map((type) => type.label).join(', ')"
                            >
                            </div>
                            <h4
                              class="flex flex-wrap items-center gap-x-3 gap-y-2 font-title text-2xl font-bold leading-tight text-primary-950 sm:text-3xl"
                            >
                              <a
                                x-bind:href="programUrl(program)"
                                class="underline-offset-4 hover:underline hover:decoration-mango-300 hover:decoration-2"
                                x-text="program.program_name.trim()"></a>
                              <template x-for="degree in degrees(program)" x-bind:key="degree">
                                <span
                                  class="bg-primary-900 px-2.5 py-1.5 font-sans text-xs font-bold uppercase leading-none tracking-wide text-white"
                                  x-text="degree"></span>
                              </template>
                            </h4>
                          </div>
                          <div
                            class="flex flex-wrap items-center gap-x-6 border-t border-slate-200 pt-1 lg:border-t-0 lg:pt-0"
                          >
                            <button
                              type="button"
                              x-on:click="showDetails(program)"
                              x-bind:aria-label="`Quick view: ${program.program_name.trim()}`"
                              aria-haspopup="dialog"
                              class="flex min-h-11 items-center gap-2 text-left text-xs font-bold uppercase tracking-wide text-primary-900 hover:text-mango-800 justify-start"
                            >
                              Quick view
                              <Icon name="expand" class="size-4 shrink-0" aria-hidden="true" />
                            </button>
                            <button
                              type="button"
                              x-on:click="$store.bookmarks.toggle(program.entry_id)"
                              class="flex min-h-11 items-center gap-2 text-left text-xs font-bold uppercase tracking-wide text-primary-900 hover:text-mango-800 justify-start"
                              x-bind:aria-pressed="$store.bookmarks.has(program.entry_id)"
                              x-bind:aria-label="$store.bookmarks.has(program.entry_id) ? `Remove ${program.program_name.trim()} from saved programs` : `Save ${program.program_name.trim()}`"
                            >
                              <span
                                x-text="$store.bookmarks.has(program.entry_id) ? 'Saved' : 'Save program'"
                              ></span>
                              <Icon
                                name="bookmark"
                                class="size-5"
                                x-bind:class="$store.bookmarks.has(program.entry_id) ? 'fill-mango-300' : ''"
                                aria-hidden="true"
                              />
                            </button>
                          </div>
                        </div>
                      </article>
                    </template>
                  </div>
                </div>
              </article>
            </template>
          </div>
        </div>
      </section>

      <section class="bg-primary-900 bg-cover bg-center bg-no-repeat py-16 text-white lg:py-24">
        <div
          class="mx-auto w-full max-w-7xl px-5 sm:px-8 grid items-center gap-8 md:grid-cols-2 lg:gap-12"
        >
          <div>
            <h2
              class="font-title text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl"
            >
              Messiah's unique approach to hands-on learning
            </h2>
            <p class="mt-4 leading-relaxed text-white/85 sm:text-lg">
              Learning in the classroom is important but actually applying that knowledge in a
              hands-on way can make all the difference. At Messiah University, the Experiential
              Learning Initiative (ELI) gives students opportunities to apply what they have learned
              through internships, service learning, off-campus programs, student leadership and
              undergraduate research.
            </p>
          </div>
          <Youtube
            videoId="GjSNNxVuoWA"
            litebox
            alt="Learn about hands-on learning at Messiah University"
          />
        </div>
      </section>

      <section class="bg-slate-50 py-16 lg:py-24">
        <div class="wrapper-md text-center">
          <h2
            class="max-w-4xl text-balance font-title text-4xl font-bold leading-tight tracking-tight text-primary-950 sm:text-5xl lg:text-6xl mx-auto"
          >
            Tell us more about yourself!
          </h2>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg mx-auto">
            Complete the form to receive more information about business and leadership programs at
            Messiah University.
          </p>
          <div class="ug-rfi mt-10 text-left">
            <div id="form_da8c5c4f-8a12-4118-8dca-066c7496f427">Loading…</div>
            <script
              is:inline
              async
              src="https://mcadmissions.messiah.edu/register/?id=da8c5c4f-8a12-4118-8dca-066c7496f427&output=embed&div=form_da8c5c4f-8a12-4118-8dca-066c7496f427"
            ></script>
          </div>
        </div>
      </section>
    </main>

    <ProgramDrawer />
  </div>

  <script is:inline>
    // @ts-nocheck
    function interestAreaPage() {
      const types = [
        { field: "major", key: "M", label: "Major", color: "#273d5e" },
        { field: "minor", key: "m", label: "Minor", color: "#4d87a9" },
        { field: "concentration", key: "C", label: "Concentration", color: "#ab4e42" },
        { field: "pre_health", key: "P", label: "Pre-Health Advising", color: "#7477b8" },
        { field: "partner_program", key: "3+", label: "3+ Partner Program", color: "#84ab8b" },
        {
          field: "teaching_certification",
          key: "T",
          label: "Teaching Certificate",
          color: "#e37b65",
        },
        { field: "accelerated", key: "A", label: "Accelerated", color: "#dcac42" },
        { field: "early_assurance", key: "E", label: "Early Assurance", color: "#777" },
        {
          field: "undergrad_certificate",
          key: "UC",
          label: "Undergraduate Certificate",
          color: "#333",
        },
      ];

      return {
        category: "business-leadership-innovation",
        accordionDefinitions: [],
        loading: true,
        error: false,
        programs: [],
        openProgram: null,

        async loadPrograms() {
          this.loading = true;
          this.error = false;

          try {
            const [data, definitions] = await Promise.all(
              [
                "https://www.messiah.edu/_program_data/ug-json.json",
                "https://www.messiah.edu/_program_data/messiah-interest-accordions.json",
              ].map(async (url) => {
                const response = await fetch(url);
                if (!response.ok) throw new Error(`Request failed (${response.status})`);
                return response.json();
              }),
            );
            if (!Array.isArray(data.items) || !Array.isArray(definitions)) {
              throw new Error("Invalid program or accordion data");
            }
            this.accordionDefinitions = definitions;
            this.programs = data.items.filter(
              (program) => program.hide_on_program_listing !== "yes",
            );
            this.$store.bookmarks.keepOnly(this.programs.map((program) => program.entry_id));
          } catch {
            this.error = true;
          } finally {
            this.loading = false;
          }
        },

        get groups() {
          const definitions = new Map(
            this.accordionDefinitions.map((definition, index) => [
              definition.subcategory_id,
              { ...definition, order: index },
            ]),
          );
          const groups = new Map();

          for (const program of this.programs) {
            for (const entry of program.academic_categories || []) {
              if (entry.category_id !== this.category || !entry.subcategory_id) continue;

              const id = entry.subcategory_id;
              if (!groups.has(id)) {
                const definition = definitions.get(id);
                groups.set(id, {
                  id,
                  heading: this.headingHtml(definition?.heading, entry.subcategory_name || id),
                  iconUrl: definition?.iconUrl || null,
                  order: definition?.order ?? definitions.size,
                  programs: [],
                });
              }
              const group = groups.get(id);
              if (!group.programs.some((item) => item.entry_id === program.entry_id)) {
                group.programs.push(program);
              }
            }
          }

          return [...groups.values()].sort((a, b) => a.order - b.order);
        },

        headingHtml(heading, fallback) {
          // Preserve emphasis from the feed while treating all other markup as text.
          return String(heading || fallback)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/&lt;strong&gt;/gi, "<strong>")
            .replace(/&lt;\/strong&gt;/gi, "</strong>");
        },

        get relatedPrograms() {
          if (!this.openProgram?.related_programs) return [];

          return this.openProgram.related_programs
            .split("|")
            .map((id) => this.programs.find((program) => String(program.entry_id) === id.trim()))
            .filter(Boolean)
            .slice(0, 3);
        },

        showDetails(program) {
          this.openProgram = program;
        },

        closeDetails() {
          this.openProgram = null;
        },

        programUrl(program) {
          const path = (program?.program_url || program?.url_slug || "").trim();
          if (!path) return null;
          if (/^https?:\/\//i.test(path)) return path;
          return `https://www.messiah.edu/${path.replace(/^\/+/, "")}`;
        },

        degrees(program) {
          return program?.degree && program.degree !== "none"
            ? program.degree
                .split("|")
                .map((degree) => degree.trim())
                .filter(Boolean)
            : [];
        },

        programTypes(program) {
          if (!program) return [];
          return types.filter((type) => program[type.field] === "true");
        },

        careerItems(program) {
          return (program?.job_title || "")
            .split(/,|\r?\n/)
            .map((item) => item.trim())
            .filter(Boolean);
        },
      };
    }
  </script>
</BaseLayout>
