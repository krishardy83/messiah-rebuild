---
import "../styles/program-discovery.css";
import BaseLayout from "../layouts/base.astro";
import ProgramDrawer from "../views/majors-minors-new/program-drawer.astro";
import ProgramCard from "../views/majors-minors-new/program-card.astro";
import Footer from "../views/majors-minors-new/footer.astro";
import KeepExploring from "../views/majors-minors-new/keep-exploring.astro";
import TabNavigation from "../views/majors-minors-new/tab-navigation.astro";
import Hero from "../views/majors-minors-new/hero.astro";
---

<BaseLayout
  title="Academic Program Match Quiz"
  description="Answer three quick questions to discover Messiah University undergraduate majors, minors and academic programs that fit your interests."
>
  <div class="program-discovery" x-data="programMatchQuiz()">
    <Hero
      eyebrow="Your program match starts here"
      title="Program finder quiz"
      imageUrl="/images/quiz.webp"
    >
      Tell us what interests you, and we’ll point you toward academic programs worth exploring.
    </Hero>

    <main id="content">
      <TabNavigation active="quiz" />

      <section id="quiz" class="discovery-section" aria-labelledby="quiz-heading">
        <div class="discovery-container">
          <div>
            <div class="mb-8 lg:mb-10" aria-label="Quiz progress">
              <div class="h-1.5 overflow-hidden bg-slate-200" aria-hidden="true">
                <div
                  class="h-full bg-mango-300 transition-all duration-500"
                  :style="`width: ${subcategory ? 100 : area ? 67 : groupChoice ? 33 : 12}%`"
                >
                </div>
              </div>
            </div>

            <div class="min-w-0">
              <p x-show="quizLoading" role="status" class="text-lg text-slate-600">Loading quiz…</p>
              <div x-show="quizError" x-cloak role="alert" class="discovery-error">
                <h2 class="font-title text-2xl font-bold">We couldn’t load the quiz.</h2>
                <p class="mt-2">
                  Please try again, or browse the <a href="/majors-minors-2b/" class="underline"
                    >complete A–Z program listing</a
                  >.
                </p>
                <button type="button" @click="loadQuiz()" class="mt-4 font-bold underline"
                  >Try again</button
                >
              </div>
              <div x-show="!quizLoading && !quizError && !groupChoice" x-cloak x-transition.opacity>
                <p class="text-xs font-extrabold uppercase tracking-[.18em] text-mango-800">
                  Question one of three
                </p>
                <h2 id="quiz-heading" class="discovery-heading mt-3">What sounds most like you?</h2>
                <p class="discovery-intro">
                  Start with the statement that feels closest to you. There’s no wrong answer—and
                  you can always explore another direction.
                </p>

                <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                  <template x-for="(choice, index) in groups" :key="index">
                    <button
                      type="button"
                      @click="selectGroup(index)"
                      class="discovery-choice group"
                    >
                      <span
                        class="grid size-11 shrink-0 place-items-center bg-slate-100 text-primary-700 transition group-hover:bg-mango-300 group-hover:text-primary-950"
                        aria-hidden="true"
                      >
                        <img
                          :src="iconUrl(choice.icon)"
                          alt=""
                          width="24"
                          height="24"
                          class="size-6"
                        />
                      </span>
                      <span class="flex min-h-32 flex-1 flex-col justify-between">
                        <span
                          class="font-title text-xl font-bold leading-tight text-primary-950"
                          x-text="choice.label"></span>
                        <span
                          class="mt-3 block text-sm leading-relaxed text-slate-600"
                          x-text="choice.subheading"></span>
                        <span
                          class="mt-auto pt-4 text-xs font-extrabold uppercase tracking-wider text-mango-800"
                          >Choose <span aria-hidden="true">→</span></span
                        >
                      </span>
                    </button>
                  </template>
                </div>
              </div>

              <div x-show="groupChoice && !area" x-cloak x-transition.opacity>
                <button
                  type="button"
                  @click="changeGroup()"
                  class="mb-7 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-primary-700"
                >
                  <span aria-hidden="true">←</span> Back
                </button>
                <p class="text-xs font-extrabold uppercase tracking-[.18em] text-mango-800">
                  Question two of three
                </p>
                <h2 class="discovery-heading mt-3">What are you most curious about?</h2>
                <p class="discovery-intro">
                  Choose the academic area you’d most like to explore right now.
                </p>

                <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                  <template x-for="(choice, index) in visibleAreas" :key="choice.id">
                    <button
                      type="button"
                      @click="selectArea(choice.id)"
                      class="discovery-choice group"
                    >
                      <span
                        class="grid size-11 shrink-0 place-items-center bg-slate-100 text-xs font-extrabold text-primary-700 transition group-hover:bg-mango-300 group-hover:text-primary-950"
                        aria-hidden="true"
                      >
                        <template x-if="choice.icon">
                          <img
                            :src="iconUrl(choice.icon)"
                            alt=""
                            width="24"
                            height="24"
                            class="size-6"
                          />
                        </template>
                        <template x-if="!choice.icon">
                          <span x-text="String(index + 1).padStart(2, '0')"></span>
                        </template>
                      </span>
                      <span class="flex min-h-32 flex-1 flex-col justify-between">
                        <span
                          class="font-title text-xl font-bold leading-tight text-primary-950"
                          x-text="choice.label"></span>
                        <span
                          class="mt-3 block text-sm leading-relaxed text-slate-600"
                          x-text="choice.subheading"></span>
                        <span
                          class="mt-auto pt-4 text-xs font-extrabold uppercase tracking-wider text-mango-800"
                          >Choose <span aria-hidden="true">→</span></span
                        >
                      </span>
                    </button>
                  </template>
                </div>
              </div>

              <div x-show="area && !subcategory" x-cloak x-transition.opacity>
                <button
                  type="button"
                  @click="changeArea()"
                  class="mb-7 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-primary-700"
                >
                  <span aria-hidden="true">←</span> Back
                </button>
                <p class="text-xs font-extrabold uppercase tracking-[.18em] text-mango-800">
                  Question three of three
                </p>
                <h2 class="discovery-heading mt-3">Which of these could you see yourself doing?</h2>
                <p class="discovery-intro">Choose the direction you’d most like to explore.</p>

                <p x-show="loading" role="status" class="mt-8 text-lg text-slate-600">
                  Loading your options…
                </p>
                <div x-show="error" role="alert" class="discovery-error mt-8">
                  <h3 class="font-title text-2xl font-bold">We couldn’t load your options.</h3>
                  <p class="mt-2">
                    Please try again, or browse the <a href="/majors-minors-2b/" class="underline"
                      >complete A–Z program listing</a
                    >.
                  </p>
                  <button type="button" @click="loadPrograms()" class="mt-4 font-bold underline"
                    >Try again</button
                  >
                </div>
                <div
                  x-show="!loading && !error"
                  class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
                >
                  <template x-for="(choice, index) in visibleSubcategories" :key="choice.key">
                    <button
                      type="button"
                      @click="selectSubcategory(choice.subcategory_id)"
                      class="discovery-choice group"
                    >
                      <span
                        class="grid size-11 shrink-0 place-items-center bg-slate-100 text-xs font-extrabold text-primary-700 transition group-hover:bg-mango-300 group-hover:text-primary-950"
                        aria-hidden="true"
                        x-text="String(index + 1).padStart(2, '0')"></span>
                      <span class="flex min-h-32 flex-1 flex-col justify-between">
                        <span
                          class="font-title text-xl font-bold leading-tight text-primary-950"
                          x-text="choice.subcategory_name"></span>
                        <span
                          class="mt-auto pt-4 text-xs font-extrabold uppercase tracking-wider text-mango-800"
                          >See my matches <span aria-hidden="true">→</span></span
                        >
                      </span>
                    </button>
                  </template>
                </div>
                <div
                  x-show="!loading && !error && visibleSubcategories.length === 0"
                  class="mt-8 border border-slate-200 p-8 text-center"
                >
                  <h3 class="font-title text-3xl font-bold text-primary-950">
                    This area is being updated.
                  </h3>
                  <p class="mt-2 text-slate-600">
                    Choose another academic area or explore the full listing.
                  </p>
                  <a
                    href="/majors-minors-2b/"
                    class="mt-5 inline-flex bg-mango-300 px-6 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-950"
                    >View all programs</a
                  >
                </div>
              </div>

              <div x-show="subcategory" x-cloak x-transition.opacity aria-live="polite">
                <button
                  type="button"
                  @click="changeSubcategory()"
                  class="mb-7 inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-primary-700"
                >
                  <span aria-hidden="true">←</span> Change your answer
                </button>
                <p class="text-xs font-extrabold uppercase tracking-[.18em] text-mango-800">
                  Your matches
                </p>
                <h2 class="discovery-heading mt-3">Programs worth exploring.</h2>
                <p class="discovery-intro">
                  Based on your answer, “<strong x-text="subcategory?.subcategory_name"></strong>,”
                  these programs are a strong place to start. Save any that stand out.
                </p>

                <div
                  class="mt-8 flex flex-wrap items-center justify-between gap-4 border-y border-slate-200 py-5"
                >
                  <p class="font-title text-xl font-bold text-primary-900">
                    <span
                      x-show="!loading && !error"
                      x-text="`${results.length} ${results.length === 1 ? 'match' : 'matches'}`"
                    ></span>
                    <span x-show="loading">Finding your matches…</span>
                  </p>
                  <div class="flex flex-wrap gap-3">
                    <button
                      type="button"
                      @click="resetQuiz()"
                      class="text-xs font-extrabold uppercase tracking-wider text-primary-700 underline decoration-slate-300 underline-offset-4"
                    >
                      Start over
                    </button>
                    <a
                      href="/majors-minors-2b/"
                      class="border border-primary-900 px-4 py-2 text-xs font-extrabold uppercase tracking-wider text-primary-900 no-underline hover:bg-primary-900 hover:text-white"
                      >Browse A–Z</a
                    >
                  </div>
                </div>

                <div
                  x-show="loading"
                  class="grid gap-6 pt-8 md:grid-cols-2 lg:grid-cols-3"
                  aria-label="Loading programs"
                >
                  <template x-for="item in 3">
                    <div class="animate-pulse border border-slate-300">
                      <div class="h-40 bg-slate-200"></div><div class="space-y-4 p-6">
                        <div class="h-3 w-24 bg-slate-200"></div><div
                          class="h-8 w-4/5 bg-slate-200"
                        >
                        </div><div class="h-16 bg-slate-100"></div>
                      </div>
                    </div>
                  </template>
                </div>

                <div x-show="error" x-cloak class="mt-8 discovery-error">
                  <h3 class="font-title text-2xl font-bold">
                    We couldn’t load the program details.
                  </h3>
                  <p class="mt-2">Please try again, or use the complete A–Z program listing.</p>
                  <button type="button" @click="loadPrograms()" class="mt-4 font-bold underline"
                    >Try again</button
                  >
                </div>

                <div
                  x-show="!loading && !error"
                  x-cloak
                  class="grid gap-6 pt-8 md:grid-cols-2 lg:grid-cols-3"
                >
                  <template x-for="program in results" :key="program.entry_id">
                    <ProgramCard />
                  </template>
                </div>

                <div
                  x-show="!loading && !error && results.length === 0"
                  x-cloak
                  class="mt-8 border border-slate-200 p-8 text-center"
                >
                  <h3 class="font-title text-3xl font-bold text-primary-950">
                    This path is being updated.
                  </h3>
                  <p class="mt-2 text-slate-600">
                    Explore the full listing while we refresh these matches.
                  </p>
                  <a
                    href="/majors-minors-2b/"
                    class="mt-5 inline-flex bg-mango-300 px-6 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-950 no-underline"
                    >View all programs</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <KeepExploring active="quiz" />

      <Footer />
    </main>

    <ProgramDrawer />
  </div>

  <script is:inline>
    window.programMatchQuiz = function () {
      return {
        endpoint: "https://www.messiah.edu/_program_data/ug-json.json",
        quizEndpoint: "https://www.messiah.edu/_program_data/quiz.json",
        groups: [],
        quizLoading: true,
        quizError: "",
        selectedGroup: null,
        selectedArea: "",
        selectedSubcategory: "",
        programs: [],
        loading: true,
        error: "",
        openProgram: null,
        types: [
          { key: "major", label: "Major" },
          { key: "minor", label: "Minor" },
          { key: "concentration", label: "Concentration" },
          { key: "pre_health", label: "Pre-health advising" },
          { key: "teaching_certification", label: "Teaching certification" },
          { key: "accelerated", label: "Accelerated" },
          { key: "partner_program", label: "3+ partner program" },
          { key: "early_assurance", label: "Early assurance" },
          { key: "undergrad_certificate", label: "Undergraduate certificate" },
        ],
        init() {
          this.loadQuiz();
          this.loadPrograms();
        },
        async loadQuiz() {
          this.quizLoading = true;
          this.quizError = "";
          try {
            const response = await fetch(this.quizEndpoint);
            if (!response.ok) throw new Error(`The server returned ${response.status}.`);
            const data = await response.json();
            if (
              !Array.isArray(data) ||
              !data.length ||
              data.some(
                (group) =>
                  typeof group.label !== "string" ||
                  !Array.isArray(group.answers) ||
                  !group.answers.length ||
                  group.answers.some(
                    (answer) =>
                      typeof answer.id !== "string" ||
                      !answer.id ||
                      typeof answer.label !== "string",
                  ),
              )
            )
              throw new Error("The quiz data is unavailable.");
            this.groups = data;
            const params = new URLSearchParams(window.location.search);
            const area = params.get("area");
            const parentIndex = this.groups.findIndex((group) =>
              group.answers.some((answer) => answer.id === area),
            );
            this.selectedGroup = null;
            this.selectedArea = "";
            this.selectedSubcategory = "";
            if (parentIndex !== -1) {
              this.selectedGroup = parentIndex;
              this.selectedArea = area;
              this.selectedSubcategory = params.get("subcategory") || "";
            } else if (/^\d+$/.test(params.get("group") || "")) {
              const index = Number(params.get("group"));
              if (this.groups[index]) this.selectedGroup = index;
            }
          } catch (error) {
            this.quizError = error instanceof Error ? error.message : "Please try again.";
          } finally {
            this.quizLoading = false;
          }
        },
        async loadPrograms() {
          this.loading = true;
          this.error = "";
          try {
            const response = await fetch(this.endpoint);
            if (!response.ok) throw new Error(`The server returned ${response.status}.`);
            const data = await response.json();
            if (!Array.isArray(data.items)) throw new Error("The program data is unavailable.");
            this.programs = data.items;
          } catch (error) {
            this.error = error instanceof Error ? error.message : "Please try again in a moment.";
          } finally {
            this.loading = false;
          }
        },
        get area() {
          return this.visibleAreas.find((item) => item.id === this.selectedArea) || null;
        },
        get groupChoice() {
          return this.groups[this.selectedGroup] || null;
        },
        get visibleAreas() {
          return this.groupChoice?.answers || [];
        },
        get visibleSubcategories() {
          if (!this.area) return [];
          const unique = new Map();
          for (const program of this.programs) {
            if (!Array.isArray(program.academic_categories)) continue;
            for (const category of program.academic_categories) {
              if (
                category?.category_id !== this.selectedArea ||
                typeof category.subcategory_id !== "string" ||
                !category.subcategory_id.trim() ||
                typeof category.subcategory_name !== "string" ||
                !category.subcategory_name.trim()
              )
                continue;
              const key = JSON.stringify([category.category_id, category.subcategory_id]);
              if (!unique.has(key)) unique.set(key, { ...category, key });
            }
          }
          return [...unique.values()];
        },
        get subcategory() {
          return (
            this.visibleSubcategories.find(
              (choice) => choice.subcategory_id === this.selectedSubcategory,
            ) || null
          );
        },
        get results() {
          if (!this.subcategory) return [];
          return this.programs.filter(
            (program) =>
              Array.isArray(program.academic_categories) &&
              program.academic_categories.some(
                (category) =>
                  category?.category_id === this.selectedArea &&
                  category.subcategory_id === this.selectedSubcategory,
              ),
          );
        },
        iconUrl(path) {
          if (!path) return "";
          try {
            const url = new URL(path, this.quizEndpoint);
            return url.protocol === "https:" ? url.href : "";
          } catch {
            return "";
          }
        },
        selectGroup(index) {
          if (!this.groups[index]) return;
          this.selectedGroup = index;
          this.selectedArea = "";
          this.selectedSubcategory = "";
          this.syncUrl();
          this.scrollToQuiz();
        },
        selectArea(id) {
          if (!this.visibleAreas.some((area) => area.id === id)) return;
          this.selectedArea = id;
          this.selectedSubcategory = "";
          this.syncUrl();
          this.scrollToQuiz();
        },
        selectSubcategory(id) {
          if (
            this.loading ||
            this.error ||
            !this.visibleSubcategories.some((choice) => choice.subcategory_id === id)
          )
            return;
          this.selectedSubcategory = id;
          this.syncUrl();
          this.scrollToQuiz();
        },
        changeSubcategory() {
          this.selectedSubcategory = "";
          this.syncUrl();
          this.scrollToQuiz();
        },
        changeArea() {
          this.selectedArea = "";
          this.selectedSubcategory = "";
          this.syncUrl();
          this.scrollToQuiz();
        },
        changeGroup() {
          this.selectedGroup = null;
          this.selectedArea = "";
          this.selectedSubcategory = "";
          this.syncUrl();
          this.scrollToQuiz();
        },
        resetQuiz() {
          this.changeGroup();
        },
        syncUrl() {
          const url = new URL(window.location.href);
          url.searchParams.delete("group");
          url.searchParams.delete("area");
          url.searchParams.delete("path");
          url.searchParams.delete("subcategory");
          if (this.selectedGroup !== null)
            url.searchParams.set("group", String(this.selectedGroup));
          if (this.selectedArea) url.searchParams.set("area", this.selectedArea);
          if (this.subcategory) url.searchParams.set("subcategory", this.selectedSubcategory);
          window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
        },
        scrollToQuiz() {
          this.$nextTick(() =>
            document.getElementById("quiz")?.scrollIntoView({
              behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
                ? "instant"
                : "smooth",
              block: "start",
            }),
          );
        },
        get relatedPrograms() {
          if (!this.openProgram?.related_programs) {
            return [];
          }

          return this.openProgram.related_programs
            .split("|")
            .map((id) => this.programs.find((program) => program.entry_id === id))
            .filter(Boolean)
            .slice(0, 3);
        },
        careerItems(program) {
          return (program?.job_title || "")
            .split(/,|\r?\n/)
            .map((item) => item.trim())
            .filter(Boolean);
        },
        showDetails(program) {
          this.openProgram = program;
        },
        closeDetails() {
          this.openProgram = null;
        },
        programUrl(program) {
          const path = String(program?.program_url || program?.url_slug || "").replace(/^\/+/, "");
          return path ? `/${path}` : "#";
        },
        degrees(program) {
          if (!program?.degree || program.degree === "none") return [];
          return program.degree.split("|").filter(Boolean);
        },
        programTypes(program) {
          return program ? this.types.filter((item) => program[item.key] === "true") : [];
        },
        interestTags(program) {
          return (program?.interest_group_name || "")
            .split("|")
            .map((tag) => tag.trim())
            .filter(Boolean);
        },
      };
    };
  </script>
</BaseLayout>
