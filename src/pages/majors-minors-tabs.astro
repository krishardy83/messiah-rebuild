  </style>

  <script is:inline>
    window.programTabs = function () {
      const validTabs = ["overview", "courses", "outcomes", "career-preparation", "why-messiah"];

      return {
        active: "overview",
        init() {
          const hash = window.location.hash.slice(1);
          if (validTabs.includes(hash)) this.active = hash;
        },
        isActive(id) {
          return this.active === id;
        },
        select(id) {
          this.active = id;
          history.replaceState(null, "", `#${id}`);
        },
      };
    };
  </script>
