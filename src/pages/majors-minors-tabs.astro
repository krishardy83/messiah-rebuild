      white-space: nowrap;
    }

    @media (min-width: 64rem) {
      .program-tab-list {
        width: 100%;
      }

      .program-tab-list > [role="tab"] {
        min-width: 0;
        flex: 1 1 20%;
        white-space: normal;
      }
