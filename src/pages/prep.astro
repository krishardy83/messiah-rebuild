---
import Accordion from "../components/accordion.astro";
import BaseLayout from "../layouts/base.astro";

const services = [
  {
    number: "01",
    title: "Individualized wellness",
    summary:
      "Certified strength and conditioning coaches and exercise physiologists pair a holistic wellness assessment with a program shaped around each client.",
    detail:
      "For students, that means seeing how assessment, listening and sound exercise principles come together in a plan designed for a real person—not a hypothetical case.",
  },
  {
    number: "02",
    title: "Human Performance Lab",
    summary:
      "The Human Performance Lab uses specialized equipment to measure and analyze a range of physiological metrics.",
    detail:
      "It is a setting where students can connect the science of human movement and performance with the information practitioners use to guide care.",
  },
  {
    number: "03",
    title: "Adaptive group training",
    summary:
      "Adaptive classes are designed and facilitated by licensed therapists, registered dietitians and certified exercise physiologists.",
    detail:
      "Students encounter the collaborative, adaptable approach required to help people with different needs participate safely and make progress together.",
  },
];
---

<BaseLayout
  title="PREP: Hands-on Experience in Health and Human Performance"
  description="Discover how Messiah University students interested in athletic training and physical therapy gain hands-on experience through PREP, a community-centered wellness program."
>
  <main id="content" class="bg-white text-slate-800" data-analytics="prep">
    <section
      class="relative isolate -mt-32 flex min-h-[680px] items-end overflow-hidden bg-primary-950 text-white"
    >
      <img
        src="/images/prep/prep-hero.jpg"
        alt="A PREP team member supports a community client exercising on a treadmill"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-[58%_center]"
        width="1500"
        height="1001"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-r from-primary-950 via-primary-900/85 to-primary-900/10"
      >
      </div>
      <div
        class="absolute inset-x-0 bottom-0 -z-10 h-48 bg-gradient-to-t from-primary-950/85 to-transparent"
      >
      </div>

      <div class="mx-auto w-full max-w-7xl px-5 pb-16 pt-44 sm:px-8 lg:pb-20">
        <div class="max-w-4xl">
          <h1
            class="font-title text-4xl font-bold uppercase leading-[.95] tracking-tight sm:text-5xl lg:text-6xl"
          >
            Turn Classroom Learning into Real Client Experience
          </h1>
          <p
            class="mt-6 max-w-2xl font-title text-2xl font-bold uppercase leading-tight text-tertiary-300 sm:text-3xl"
          >
            Practice your health studies with PREP
          </p>
        </div>
      </div>
    </section>

    <nav
      aria-label="On this page"
      class="sticky top-0 z-20 hidden border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur lg:block"
    >
      <div class="mx-auto flex max-w-7xl items-center gap-8 px-8 py-4 text-sm">
        <strong class="text-primary-800">Explore PREP</strong>
        <a class="link" href="#what-is-prep">What it is</a>
        <a class="link" href="#student-experience">Student experience</a>
        <a class="link" href="#services">Services</a>
        <a class="link" href="#next-steps">Your next steps</a>
      </div>
    </nav>

    <section id="what-is-prep" class="scroll-mt-24 pb-10 pt-16 sm:pb-12 sm:pt-24">
      <div
        class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:items-start"
      >
        <div>
          <h2 class="font-title text-4xl font-bold leading-tight text-primary-800 sm:text-5xl">
            Messiah students don't wait until graduate school to work with clients.
          </h2>
        </div>
        <div
          class="border-l-4 border-tertiary-400 pl-6 text-lg leading-relaxed text-slate-600 sm:pl-8"
        >
          <p class="mb-4 font-bold uppercase tracking-[.18em] text-tertiary-600">What is PREP?</p>
          <p>
            PREP stands for <strong class="text-slate-800"
              >Preventative and Rehabilitative Exercise Programs</strong
            >. It serves people continuing the care they recently received, people encouraged by a
            health provider to become more active and people looking for a more personal path to
            wellness.
          </p>
          <p class="mt-5">
            Instead of a one-size-fits-all workout, PREP looks at the whole person. Programs are
            shaped around each client’s needs, goals and lived experience.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-white pb-16 sm:pb-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div
          class="relative mx-auto grid max-w-6xl overflow-hidden bg-primary-800 text-white shadow-lg md:grid-cols-[.75fr_1.25fr]"
        >
          <div
            class="flex flex-col items-center justify-center bg-tertiary-400 px-8 py-9 text-center text-primary-950 sm:py-11"
          >
            <span class="text-sm font-bold uppercase tracking-[.2em]">Over</span>
            <strong class="font-title text-7xl font-bold leading-none sm:text-8xl">150</strong>
            <span class="font-bold uppercase tracking-wide">students each year</span>
          </div>

          <div class="flex flex-col justify-center px-7 py-9 sm:px-10 sm:py-11 lg:px-14">
            <p class="text-lg leading-relaxed text-primary-50 sm:text-xl">
              Undergrad and grad students learn on the job each year through the PREP program. Work
              in our state-of-the-art facilities alongside working professionals.
            </p>
            <a
              href="#services"
              class="mt-6 inline-flex w-fit items-center gap-3 font-title text-lg font-bold uppercase tracking-wide text-white transition hover:text-tertiary-300"
            >
              See how each program uses PREP
              <span class="text-2xl" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="student-experience" class="scroll-mt-24 bg-primary-800 text-white">
      <div class="mx-auto grid max-w-[1600px] lg:grid-cols-2">
        <div class="relative min-h-[430px] lg:min-h-[680px]">
          <img
            src="/images/prep/prep-community.jpg"
            alt="A PREP team member guides a community client through a resistance exercise"
            class="absolute inset-0 h-full w-full object-cover object-center"
            width="800"
            height="877"
            loading="lazy"
          />
          <div class="absolute bottom-0 right-0 bg-tertiary-400 px-6 py-4 text-primary-950 sm:px-8">
            <p class="font-title text-2xl font-bold uppercase">Real clients. Real growth.</p>
          </div>
        </div>

        <div class="flex items-center px-5 py-16 sm:px-12 lg:px-16 lg:py-20">
          <div class="max-w-2xl">
            <p class="font-bold uppercase tracking-[.18em] text-tertiary-300">
              The student experience
            </p>
            <h2 class="mt-3 font-title text-4xl font-bold leading-tight sm:text-5xl">
              Knowledge becomes practice when a person is counting on you.
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-primary-100">
              Messiah students work with campus clients through PREP, gaining hands-on experience in
              an environment built around individualized attention, professional collaboration and
              whole-person care.
            </p>

            <ul class="mt-9 grid gap-6 sm:grid-cols-2" role="list">
              <li class="border-t border-white/25 pt-5">
                <strong class="block font-title text-2xl text-tertiary-300">Connect</strong>
                <span class="mt-2 block leading-relaxed text-primary-100"
                  >Build trust and communicate with clients whose goals and needs are their own.</span
                >
              </li>
              <li class="border-t border-white/25 pt-5">
                <strong class="block font-title text-2xl text-tertiary-300">Apply</strong>
                <span class="mt-2 block leading-relaxed text-primary-100"
                  >Bring classroom learning into a working health and human-performance setting.</span
                >
              </li>
              <li class="border-t border-white/25 pt-5">
                <strong class="block font-title text-2xl text-tertiary-300">Adapt</strong>
                <span class="mt-2 block leading-relaxed text-primary-100"
                  >See how plans change in response to the person, their progress and their
                  feedback.</span
                >
              </li>
              <li class="border-t border-white/25 pt-5">
                <strong class="block font-title text-2xl text-tertiary-300">Collaborate</strong>
                <span class="mt-2 block leading-relaxed text-primary-100"
                  >Learn in a space shaped by exercise physiologists, coaches, therapists and
                  dietitians.</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="scroll-mt-24 bg-slate-50 py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-5 sm:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <p class="font-bold uppercase tracking-[.18em] text-tertiary-600">Inside the program</p>
          <h2 class="mt-3 font-title text-4xl font-bold leading-tight text-primary-800 sm:text-5xl">
            Different ways to support health and performance.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">
            PREP meets clients in different places on their wellness journey. Open each service to
            see what makes it valuable for clients—and instructive for students.
          </p>
        </div>

        <div class="mt-12">
          {
            services.map((service) => (
              <Accordion
                id={`prep-service-${service.number}`}
                title={`${service.number} &nbsp; ${service.title}`}
                class="mb-3 border-slate-300 bg-white shadow-sm"
              >
                <div class="grid gap-5 text-base leading-relaxed text-slate-600 md:grid-cols-2 md:gap-10">
                  <div>
                    <strong class="mb-2 block text-sm uppercase tracking-wider text-primary-800">
                      For community clients
                    </strong>
                    <p>{service.summary}</p>
                  </div>
                  <div>
                    <strong class="mb-2 block text-sm uppercase tracking-wider text-primary-800">
                      For Messiah students
                    </strong>
                    <p>{service.detail}</p>
                  </div>
                </div>
              </Accordion>
            ))
          }
        </div>

        <div class="mt-8 text-center">
          <a
            href="https://fitness.messiah.edu/prep/our-services/"
            class="btn-tertiary"
            target="_blank"
            rel="noreferrer"
          >
            Explore PREP services
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="grid overflow-hidden bg-tertiary-50 lg:grid-cols-[.9fr_1.1fr]">
          <div class="bg-tertiary-500 p-8 text-white sm:p-12">
            <p class="font-bold uppercase tracking-[.18em] text-primary-950">Why it matters</p>
            <p class="mt-5 font-title text-4xl font-bold leading-tight sm:text-5xl">
              Health care is personal. Your preparation should be, too.
            </p>
          </div>
          <div class="p-8 sm:p-12">
            <p class="text-lg leading-relaxed text-slate-700">
              Careers in athletic training and physical therapy call for more than scientific
              knowledge. They require careful observation, clear communication, flexibility and
              genuine care for the person in front of you. PREP gives students a place to begin
              developing those habits while making a difference on campus.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="next-steps" class="scroll-mt-24 bg-primary-950 py-16 text-white sm:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:items-end">
          <div>
            <p class="font-bold uppercase tracking-[.18em] text-tertiary-300">Your next steps</p>
            <h2 class="mt-3 font-title text-4xl font-bold leading-tight sm:text-5xl">
              Picture yourself in the work.
            </h2>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-primary-100">
              Explore the programs that can lead you toward a career in movement, rehabilitation and
              whole-person health—then come see the learning environment for yourself.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-3">
            <a
              href="/majors-minors"
              class="group flex min-h-44 flex-col justify-between border border-white/20 bg-white/5 p-6 transition hover:-translate-y-1 hover:bg-white/10"
            >
              <span class="text-sm font-bold uppercase tracking-wider text-tertiary-300"
                >Explore</span
              >
              <span class="font-title text-2xl font-bold">Athletic training</span>
              <span
                class="text-xl transition-transform group-hover:translate-x-1"
                aria-hidden="true">→</span
              >
            </a>
            <a
              href="/majors-minors"
              class="group flex min-h-44 flex-col justify-between border border-white/20 bg-white/5 p-6 transition hover:-translate-y-1 hover:bg-white/10"
            >
              <span class="text-sm font-bold uppercase tracking-wider text-tertiary-300"
                >Explore</span
              >
              <span class="font-title text-2xl font-bold">Pre-physical therapy</span>
              <span
                class="text-xl transition-transform group-hover:translate-x-1"
                aria-hidden="true">→</span
              >
            </a>
            <a
              href="/visit"
              class="group flex min-h-44 flex-col justify-between bg-tertiary-400 p-6 text-primary-950 transition hover:-translate-y-1 hover:bg-tertiary-300"
            >
              <span class="text-sm font-bold uppercase tracking-wider">Come to campus</span>
              <span class="font-title text-2xl font-bold">Plan your visit</span>
              <span
                class="text-xl transition-transform group-hover:translate-x-1"
                aria-hidden="true">→</span
              >
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
