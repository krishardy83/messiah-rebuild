  <script is:inline>
    (() => {
      const globalNavigation = document.querySelector("[data-global-navigation]");
      const pageNavigation = document.querySelector("[data-page-navigation]");

      if (!(globalNavigation instanceof HTMLElement) || !(pageNavigation instanceof HTMLElement)) {
        return;
      }

      const links = Array.from(pageNavigation.querySelectorAll("[data-section-link]"));
      const sections = links
        .map((link) => document.querySelector(link.getAttribute("href")))
        .filter((section) => section instanceof HTMLElement);
      let animationFrame;
      let transitionFrame;

      const updateNavigation = () => {
        animationFrame = undefined;

        const globalNavigationBottom = Math.max(
          0,
          Math.ceil(globalNavigation.getBoundingClientRect().bottom),
        );
        const pageNavigationHeight = pageNavigation.offsetHeight;
        const sectionOffset = globalNavigationBottom + pageNavigationHeight + 16;

        pageNavigation.style.setProperty(
          "--global-navigation-bottom",
          `${globalNavigationBottom}px`,
        );
        document.documentElement.style.setProperty("--page-scroll-offset", `${sectionOffset}px`);

        let activeSection;

        for (const section of sections) {
          if (section.getBoundingClientRect().top <= sectionOffset + 24) {
            activeSection = section;
          }
        }

        for (const link of links) {
          const isActive = activeSection && link.getAttribute("href") === `#${activeSection.id}`;

          link.dataset.active = String(Boolean(isActive));

          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      };

      const scheduleUpdate = () => {
        if (animationFrame) return;
        animationFrame = requestAnimationFrame(updateNavigation);
      };

      const trackHeaderTransition = () => {
        cancelAnimationFrame(transitionFrame);
        const start = performance.now();

        const track = () => {
          scheduleUpdate();

          if (performance.now() - start < 400) {
            transitionFrame = requestAnimationFrame(track);
          }
        };

        transitionFrame = requestAnimationFrame(track);
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate);
      globalNavigation.addEventListener("transitionrun", trackHeaderTransition);

      const resizeObserver = new ResizeObserver(scheduleUpdate);
      resizeObserver.observe(globalNavigation);
      resizeObserver.observe(pageNavigation);

      updateNavigation();
    })();
  </script>
