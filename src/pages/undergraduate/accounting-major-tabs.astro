  <script is:inline>
    window.programTabs = function () {
      const validTabs = ["overview", "courses", "outcomes", "career-preparation", "why-messiah"];

      return {
        active: "overview",
        init() {
          const hash = window.location.hash.slice(1);
          if (validTabs.includes(hash)) this.active = hash;
        },
        isActive(id) {
          return this.active === id;
        },
        select(id) {
          this.active = id;
          history.replaceState(null, "", `#${id}`);
        },
      };
    };

    (() => {
      const sections = Array.from(document.querySelectorAll("[data-count-up-section]"));
      if (!sections.length || !("IntersectionObserver" in window)) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      sections.forEach((section) => {
        section.querySelectorAll("[data-count-up]").forEach((counter) => {
          counter.textContent = `0${counter.dataset.countSuffix ?? ""}`;
        });
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);

            const counters = Array.from(entry.target.querySelectorAll("[data-count-up]"));
            const duration = 1400;
            requestAnimationFrame((startTime) => {
              const update = (currentTime) => {
                const progress = Math.min((currentTime - startTime) / duration, 1);
                const easedProgress = 1 - Math.pow(1 - progress, 3);

                counters.forEach((counter) => {
                  const target = Number(counter.dataset.countUp);
                  const suffix = counter.dataset.countSuffix ?? "";
                  counter.textContent = `${Math.round(target * easedProgress)}${suffix}`;
                });

                if (progress < 1) requestAnimationFrame(update);
              };

              requestAnimationFrame(update);
            });
          });
        },
        { threshold: 0.35 },
      );

      sections.forEach((section) => observer.observe(section));
    })();
  </script>
