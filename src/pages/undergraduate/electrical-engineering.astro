---
import ProgramList, { Program } from "../../components/program-list.astro";
import Youtube from "../../components/youtube.astro";
import BaseLayout from "../../layouts/base.astro";

const catalogUrl =
  "https://messiah.smartcatalogiq.com/2025-2026/undergraduate-catalog/school-of-science-engineering-and-health/department-of-engineering/electrical-engineering";

const distinctives = [
  "Participate in the Integrated Projects Curriculum, a five-semester sequence completed in partnership with the Collaboratory.",
  "Use classroom learning to solve authentic problems for local and international clients.",
  "Learn to use industry-standard computer design tools.",
  "Experiment with new ideas in updated laboratories designed for undergraduate students.",
  "Design circuits and electrical systems that can be fabricated and installed to solve real problems.",
  "Build practical fabrication and debugging skills through hands-on work.",
];

const coursePlan = [
  {
    kicker: "Year 1",
    title: "100-level courses",
    courses: [
      ["CHEM 105", "General Chemistry I", "4"],
      ["ENGR 111", "Introduction to Engineering", "2"],
      ["ENGR 112", "Engineering Design Tools", "2"],
      ["MATH 111", "Calculus I", "4"],
      ["MATH 112", "Calculus II", "4"],
    ],
  },
  {
    kicker: "Year 2",
    title: "200-level courses",
    courses: [
      ["ENGR 211", "Project Management", "1"],
      ["ENGR 212", "Programming for Engineers", "2"],
      ["ENGR 213", "Engineering Statistics", "3"],
      ["ENGR 214", "Materials Engineering", "4"],
      ["ENGR 215", "Circuits I", "4"],
      ["ENGR 216", "Mechanics I", "3"],
      ["MATH 211", "Calculus III", "4"],
      ["MATH 270", "Linear and Differential Methods", "3"],
      ["PHYS 211", "General Physics I", "4"],
      ["PHYS 212", "General Physics II", "4"],
    ],
  },
  {
    kicker: "Year 3",
    title: "300-level courses",
    courses: [
      ["ENGR 301", "Seminar I", "1"],
      ["ENGR 302", "Seminar II", "1"],
      ["ENGR 324", "Control Systems", "4"],
      ["ENGR 361", "Circuits II", "4"],
      ["ENGR 362", "Analog Electronics", "3"],
      ["ENGR 363", "Embedded Systems Design", "4"],
      ["ENGR 364", "Electrical Devices", "4"],
      ["ENGR 365", "Linear Systems", "3"],
      ["ENGR 367", "Electromagnetics", "3"],
      ["ENGR 373", "Instrumentation & Measurement", "3", "Course choice"],
    ],
  },
  {
    kicker: "Year 4",
    title: "400-level courses",
    courses: [
      ["ENGR 415", "Engineering Project", "1–3", "6 credits total; typically 1-1-2-2"],
      ["ENGR 421", "Robotic Systems", "4", "Course choice"],
      ["ENGR 422", "Industrial Automation", "4", "Course choice"],
      ["ENGR 431", "Biomedical Instrumentation", "4", "Course choice"],
      ["ENGR 461", "Communication Systems", "3"],
      ["ENGR 462", "Power Electronics", "4"],
    ],
  },
];

const careers = [
  "Control and instrumentation engineer",
  "Design engineer",
  "Manufacturing and test engineer",
  "Information technology consultant",
  "Lighting and power systems designer",
  "Network engineer",
  "Systems analyst",
];

const internshipEmployers = [
  "Stanley Black & Decker",
  "Phoenix Contact",
  "TE Connectivity",
  "Johnson Controls",
];

const relatedPrograms = [
  {
    title: "Engineering",
    image: "/images/programs/related-engineering.jpg",
    alt: "Engineering students designing with a professor",
    href: "https://www.messiah.edu/undergraduate/engineering-major",
  },
  {
    title: "Robotics Engineering",
    image: "/images/programs/related-robotics-engineering.jpg",
    alt: "An engineering student working on a robot",
    href: "https://www.messiah.edu/undergraduate/robotics-engineering-major",
  },
];
---

<BaseLayout
  title="Electrical Engineering"
  description="Discover Messiah University's ABET-accredited electrical engineering degree, which blends technical skills and Christian values for a meaningful engineering career."
>
  <main id="content" class="bg-white text-slate-900">
    <section
      class="relative isolate -mt-32 min-h-[650px] overflow-hidden bg-primary-800 text-white"
    >
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="/images/programs/electrical-engineering-hero-mobile.jpg"
        />
        <img
          src="/images/programs/electrical-engineering-hero.jpg"
          alt=""
          class="absolute inset-0 -z-20 h-full w-full object-cover"
          aria-hidden="true"
        />
      </picture>
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-r from-slate-950 via-primary-800/90 to-primary-800/10"
      >
      </div>
      <div
        class="mx-auto flex min-h-[650px] w-full max-w-7xl items-end px-5 pb-14 pt-40 sm:px-8 lg:py-20"
      >
        <div class="max-w-5xl">
          <p class="text-xs font-bold uppercase tracking-[.18em] text-[#e5ae3a]">
            Bachelor of Science in Electrical Engineering
          </p>
          <h1
            class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 font-title text-4xl font-bold uppercase leading-[.92] tracking-[-.035em] sm:text-5xl lg:text-6xl"
          >
            Electrical Engineering
            <span
              class="inline-block bg-[#e5ae3a] px-3 py-2 font-sans text-lg font-bold normal-case tracking-normal text-primary-800 sm:text-xl"
              >B.S.E.E.</span
            >
          </h1>
          <ProgramList
            programs={[Program.Major, Program.Minor]}
            showText
            class="mt-7 text-lg sm:text-xl"
          />
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-sm bg-[#e5ae3a] px-5 py-3 font-bold text-slate-950 no-underline transition hover:-translate-y-0.5 hover:bg-[#d59e2b]"
              href="#next-steps"
              >Your next steps <span class="text-lg" aria-hidden="true">↓</span></a
            >
            <button
              type="button"
              x-data="{ saved: false }"
              x-init="saved = localStorage.getItem('saved-electrical-engineering') === 'true'"
              @click="saved = !saved; localStorage.setItem('saved-electrical-engineering', String(saved))"
              :aria-pressed="saved"
              :class="saved ? 'bg-white text-primary-800' : 'bg-transparent text-white hover:bg-white/10'"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-sm border border-white/50 px-5 py-3 font-bold transition hover:-translate-y-0.5"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z"
                ></path>
              </svg>
              <span x-text="saved ? 'Program saved' : 'Save program'">Save program</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <nav
      aria-label="On this page"
      data-page-navigation
      class="sticky z-20 hidden overflow-x-auto border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur lg:block"
      style="top: var(--global-navigation-bottom, 0px)"
    >
      <div class="mx-auto flex min-w-max max-w-7xl items-center gap-6 px-5 py-4 text-sm sm:px-8">
        <strong class="text-primary-800">On this page</strong>
        {
          [
            ["Overview", "overview"],
            ["Why Messiah", "why-messiah"],
            ["Courses", "curriculum"],
            ["Careers & outcomes", "outcomes"],
            ["Career preperation", "experience"],
          ].map(([label, id]) => (
            <a
              href={`#${id}`}
              data-section-link
              class="relative py-1 text-slate-600 transition after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-[#e5ae3a] after:transition-transform hover:text-primary-800 data-[active=true]:font-bold data-[active=true]:text-primary-800 data-[active=true]:after:scale-x-100"
            >
              {label}
            </a>
          ))
        }
      </div>
    </nav>

    <section
      id="overview"
      class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-16"
    >
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Technology with purpose
        </p>
        <h2
          class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
        >
          Design products and systems that improve lives.
        </h2>
        <div class="mt-7 max-w-3xl space-y-5 text-lg leading-relaxed text-slate-600">
          <p>
            Electrical engineering students prepare to participate in the design and development of
            new products that affect every area of life.
          </p>
          <p>
            From smartphones and cars to medical technology and clean energy, electrical engineers
            work to improve the lives of people everywhere.
          </p>
        </div>
        <img
          src="/images/programs/electrical-engineering-abet.png"
          alt="ABET Engineering Accreditation Commission"
          class="mt-8 h-auto w-full max-w-sm"
        />
      </div>

      <Youtube
        videoId="SbM020CoEK4"
        preview="https://img.youtube.com/vi/SbM020CoEK4/hqdefault.jpg"
        class="w-full overflow-hidden shadow-xl"
      />
    </section>

    <section aria-labelledby="highlights-title" class="bg-primary-800 py-14 text-white md:py-16">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <p
          id="highlights-title"
          class="text-xs font-bold uppercase tracking-[.18em] text-[#e5ae3a]"
        >
          Electrical engineering at a glance
        </p>
        <div class="mt-6 grid border-y border-white/20 md:grid-cols-3">
          <article
            class="flex items-center gap-5 border-b border-white/20 py-7 md:border-b-0 md:border-r md:pr-8"
          >
            <strong class="shrink-0 font-title text-5xl text-[#e5ae3a]">100%</strong>
            <p class="m-0 text-sm leading-snug text-slate-100">
              of first-year students receive financial aid
            </p>
          </article>
          <article
            class="flex items-center gap-5 border-b border-white/20 py-7 md:border-b-0 md:border-r md:px-8"
          >
            <strong class="shrink-0 font-title text-5xl text-[#e5ae3a]">98%</strong>
            <p class="m-0 text-sm leading-snug text-slate-100">
              of the Class of 2025 respondents were employed or in graduate school within six to
              nine months of graduation
            </p>
          </article>
          <article class="flex items-center gap-5 py-7 md:pl-8">
            <strong class="shrink-0 font-title text-5xl text-[#e5ae3a]">12:1</strong>
            <p class="m-0 text-sm leading-snug text-slate-100">student-to-faculty ratio</p>
          </article>
        </div>
      </div>
    </section>

    <section id="why-messiah" class="bg-[#eaf2f6] py-24" aria-labelledby="distinctives-title">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
            Why electrical engineering at Messiah?
          </p>
          <h2
            id="distinctives-title"
            class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
          >
            Learn by designing, building and serving.
          </h2>
        </div>
        <div
          class="mt-12 grid gap-px overflow-hidden border border-slate-300 bg-slate-300 md:grid-cols-2 lg:grid-cols-3"
        >
          {
            distinctives.map((item, index) => (
              <article class="bg-white p-7">
                <span class="font-title text-2xl text-slate-400">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="mt-6 font-bold leading-relaxed">{item}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="curriculum" class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="max-w-4xl">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Courses & curriculum
        </p>
        <h2
          class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
        >
          Build a rigorous engineering foundation.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          The electrical engineering major requires 91–92 credits. Students complete 131–132 total
          credits, including 40 general education credits.
        </p>
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          coursePlan.map((year) => (
            <article class="border-t-4 border-tertiary-400 bg-[#efefef] p-5">
              <p class="text-xs font-bold uppercase tracking-widest text-primary-800">
                {year.kicker}
              </p>
              <h3 class="mt-2 font-title text-2xl font-bold text-primary-800">{year.title}</h3>
              <ul class="mt-5 space-y-4 text-sm">
                {year.courses.slice(0, 5).map(([code, name, credits, note]) => (
                  <li class="border-b border-slate-300 pb-3 last:border-0 last:pb-0">
                    <span class="flex items-start justify-between gap-3">
                      <strong class="text-primary-800">{code}</strong>
                      <span class="shrink-0 text-xs text-slate-500">{credits} credits</span>
                    </span>
                    <span class="mt-1 block text-slate-600">{name}</span>
                    {note ? (
                      <span class="mt-1 block text-xs font-bold text-tertiary-700">{note}</span>
                    ) : null}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="mt-6 max-w-5xl space-y-2 text-sm leading-relaxed text-slate-600">
        <p>
          These example listings show up to five catalog requirements at each course level. They are
          not a complete course list or an official semester sequence.
        </p>
        <p>
          The six required ENGR 415 credits are typically distributed 1-1-2-2 over the final four
          semesters. Students choose one of ENGR 373, ENGR 421, ENGR 422 or ENGR 431.
        </p>
      </div>

      <a
        href={catalogUrl}
        class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 bg-primary-800 px-5 py-3 font-bold text-white transition hover:bg-primary-700"
      >
        View catalog requirements <span aria-hidden="true">→</span>
      </a>
    </section>

    <section id="outcomes" class="bg-primary-800 py-24 text-white">
      <div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-[.9fr_1.1fr] lg:gap-24">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.18em] text-[#e5ae3a]">
            Careers & outcomes
          </p>
          <h2 class="mt-3 font-title text-4xl leading-tight tracking-tight md:text-5xl">
            Prepare for engineering work across industries.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-200">
            The program supports career preparation through a weekly Professional Development Hour,
            an annual career expo, coaching based on Collaboratory project experience and faculty
            support for internship searches.
          </p>
          <strong class="mt-10 block font-title text-7xl text-[#e5ae3a]">98%</strong>
          <span class="block max-w-md font-bold">
            of the Class of 2025 respondents were employed or in graduate school within six to nine
            months of graduation
          </span>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          <article class="bg-white/5 p-7">
            <h3 class="font-title text-2xl">Career options</h3>
            <ul class="mt-5 space-y-3 text-slate-100">
              {
                careers.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-tertiary-400" aria-hidden="true">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </article>
          <article class="bg-white/5 p-7">
            <h3 class="font-title text-2xl">Recent internship employers</h3>
            <p class="mt-4 text-sm leading-relaxed text-slate-300">
              Most students pursue a summer internship in their area of interest.
            </p>
            <ul class="mt-5 space-y-3 text-slate-100">
              {
                internshipEmployers.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-tertiary-400" aria-hidden="true">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section
      id="experience"
      class="mx-auto grid max-w-7xl items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-20"
    >
      <Youtube
        videoId="GjSNNxVuoWA"
        preview="https://img.youtube.com/vi/GjSNNxVuoWA/hqdefault.jpg"
        class="w-full overflow-hidden shadow-xl"
      />
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Career preperation
        </p>
        <h2
          class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
        >
          Put engineering skills to work through service.
        </h2>
        <div class="mt-5 space-y-5 text-lg leading-relaxed text-slate-600">
          <p>
            Starting in the second year, students work on projects that meet the needs of real-world
            clients in a Christian missions context.
          </p>
          <p>
            The Collaboratory gives engineering students five semesters of credit-bearing project
            experience. First-year students may also begin as volunteers.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-7xl gap-5 px-5 pb-24 sm:px-8 lg:grid-cols-3">
      <article class="border-t-4 border-tertiary-400 bg-[#efefef] p-8">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Applied learning
        </p>
        <h2 class="mt-3 font-title text-3xl text-primary-800">The Collaboratory</h2>
        <p class="mt-4 text-slate-600">
          Students use engineering skills to solve authentic problems for local and international
          clients, including work involving prosthetics and wheelchairs.
        </p>
        <a
          href="https://www.messiah.edu/collaboratory/"
          class="mt-5 inline-flex font-bold text-primary-800 hover:text-tertiary-600"
        >
          Explore the Collaboratory →
        </a>
      </article>
      <article class="border-t-4 border-tertiary-400 bg-[#efefef] p-8">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Specialized spaces
        </p>
        <h2 class="mt-3 font-title text-3xl text-primary-800">Modern facilities</h2>
        <p class="mt-4 text-slate-600">
          Facilities include a professionally staffed machine shop, engineering labs,
          industry-standard software, circuit prototyping equipment and a robotics lab.
        </p>
        <a
          href="https://www.messiah.edu/dept-engineering/our-facilities/"
          class="mt-5 inline-flex font-bold text-primary-800 hover:text-tertiary-600"
        >
          View engineering facilities →
        </a>
      </article>
      <article class="border-t-4 border-tertiary-400 bg-[#efefef] p-8">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">Program quality</p>
        <h2 class="mt-3 font-title text-3xl text-primary-800">ABET accreditation</h2>
        <p class="mt-4 text-slate-600">
          The electrical engineering program is accredited by the Engineering Accreditation
          Commission of ABET under the commission’s General Criteria and Program Criteria for
          Electrical Engineering.
        </p>
      </article>
    </section>

    <section class="mx-auto max-w-7xl border-t border-slate-200 px-5 py-20 sm:px-8">
      <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">Keep exploring</p>
      <h2
        class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
      >
        Related programs
      </h2>
      <div class="mt-8 grid max-w-3xl gap-5 sm:grid-cols-2">
        {
          relatedPrograms.map((program) => (
            <a
              href={program.href}
              class="group overflow-hidden border border-slate-300 bg-white font-bold text-primary-800 transition hover:border-tertiary-400 hover:shadow-lg"
            >
              <img
                src={program.image}
                alt={program.alt}
                loading="lazy"
                class="aspect-[13/12] w-full object-cover transition duration-300 group-hover:scale-[1.03] group-hover:opacity-90"
              />
              <span class="flex items-center justify-between gap-4 p-5">
                <span>{program.title}</span>
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section
      id="next-steps"
      class="scroll-mt-20 bg-gradient-to-r from-[#11698c] to-[#0b7367] py-16 text-white"
      aria-labelledby="next-steps-title"
    >
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
          <div>
            <p class="text-xs font-bold uppercase tracking-[.18em] text-white">Your next step</p>
            <h2 id="next-steps-title" class="mt-3 font-title text-4xl leading-tight md:text-5xl">
              Explore electrical engineering at Messiah.
            </h2>
          </div>
          <div class="flex w-full shrink-0 flex-col gap-3 sm:w-auto sm:flex-row">
            <a
              class="inline-flex min-h-12 items-center justify-center rounded-sm bg-[#e5ae3a] px-5 py-3 font-bold text-primary-900 transition hover:-translate-y-0.5 hover:bg-[#d59e2b]"
              href="/visit">Plan a visit</a
            >
            <a
              class="inline-flex min-h-12 items-center justify-center rounded-sm border border-white/80 px-5 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:bg-white hover:text-primary-800"
              href="https://www.messiah.edu/applytoday">Apply to Messiah</a
            >
          </div>
        </div>

        <form
          data-analytics="request-information"
          method="GET"
          action="https://www.messiah.edu/undergraduate-admissions/request-more-information/request-information"
          class="mt-10 grid gap-6 border-t border-white/30 pt-8 lg:grid-cols-[13rem_minmax(0,1fr)] lg:items-end lg:gap-8"
        >
          <div class="self-center">
            <p class="text-xs font-bold uppercase tracking-[.18em] text-tertiary-200">
              Tell us about yourself
            </p>
            <h3 class="mt-2 font-title text-2xl font-bold uppercase text-white">
              Request information
            </h3>
          </div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1.2fr_auto]">
            <div>
              <label for="ee-rfi-first-name" class="sr-only">First name</label>
              <input
                id="ee-rfi-first-name"
                type="text"
                name="firstname"
                autocomplete="given-name"
                placeholder="First name"
                required
                class="h-14 w-full border border-transparent bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:border-[#e5ae3a] focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
              />
            </div>
            <div>
              <label for="ee-rfi-last-name" class="sr-only">Last name</label>
              <input
                id="ee-rfi-last-name"
                type="text"
                name="lastname"
                autocomplete="family-name"
                placeholder="Last name"
                required
                class="h-14 w-full border border-transparent bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:border-[#e5ae3a] focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
              />
            </div>
            <div class="sm:col-span-2 lg:col-span-1">
              <label for="ee-rfi-email" class="sr-only">Email</label>
              <input
                id="ee-rfi-email"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="Email"
                required
                class="h-14 w-full border border-transparent bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:border-[#e5ae3a] focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
              />
            </div>
            <button
              type="submit"
              class="inline-flex min-h-14 w-full items-center justify-center border border-white/80 px-6 py-3 font-title font-bold uppercase tracking-wider text-white transition hover:bg-white hover:text-primary-800 focus-visible:bg-white focus-visible:text-primary-800 sm:col-span-2 lg:col-span-1 lg:w-auto"
            >
              Next
            </button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <style is:global>
    #overview,
    #why-messiah,
    #curriculum,
    #outcomes,
    #experience {
      scroll-margin-top: var(--page-scroll-offset, 8rem);
    }
  </style>

  <script is:inline>
    (() => {
      const globalNavigation = document.querySelector("[data-global-navigation]");
      const pageNavigation = document.querySelector("[data-page-navigation]");

      if (!(globalNavigation instanceof HTMLElement) || !(pageNavigation instanceof HTMLElement)) {
        return;
      }

      const links = Array.from(pageNavigation.querySelectorAll("[data-section-link]"));
      const sections = links
        .map((link) => document.querySelector(link.getAttribute("href")))
        .filter((section) => section instanceof HTMLElement);
      let animationFrame;
      let transitionFrame;

      const updateNavigation = () => {
        animationFrame = undefined;
        const globalNavigationBottom = Math.max(
          0,
          Math.ceil(globalNavigation.getBoundingClientRect().bottom),
        );
        const sectionOffset = globalNavigationBottom + pageNavigation.offsetHeight + 16;

        pageNavigation.style.setProperty(
          "--global-navigation-bottom",
          `${globalNavigationBottom}px`,
        );
        document.documentElement.style.setProperty("--page-scroll-offset", `${sectionOffset}px`);

        let activeSection;
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= sectionOffset + 24) activeSection = section;
        }

        for (const link of links) {
          const isActive = activeSection && link.getAttribute("href") === `#${activeSection.id}`;
          link.dataset.active = String(Boolean(isActive));
          if (isActive) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        }
      };

      const scheduleUpdate = () => {
        if (animationFrame) return;
        animationFrame = requestAnimationFrame(updateNavigation);
      };

      const trackHeaderTransition = () => {
        cancelAnimationFrame(transitionFrame);
        const start = performance.now();
        const track = () => {
          scheduleUpdate();
          if (performance.now() - start < 400) transitionFrame = requestAnimationFrame(track);
        };
        transitionFrame = requestAnimationFrame(track);
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate);
      globalNavigation.addEventListener("transitionrun", trackHeaderTransition);

      const resizeObserver = new ResizeObserver(scheduleUpdate);
      resizeObserver.observe(globalNavigation);
      resizeObserver.observe(pageNavigation);
      updateNavigation();
    })();
  </script>
</BaseLayout>
