---
import BaseLayout from "../../layouts/base.astro";
import ProgramList, { Program } from "../../components/program-list.astro";
import Youtube from "../../components/youtube.astro";

const coursePlan = [
  {
    kicker: "Year 1",
    title: "Foundations",
    courses: [
      ["CIS 181", "Computer Programming I", "3 credits"],
      ["ECON 120", "Principles of Macroeconomics", "3 credits"],
      ["MATH 111", "Calculus I", "4 credits"],
      ["MATH 112", "Calculus II", "4 credits"],
      ["MATH 196", "Mathematics Seminar", "2 credits"],
    ],
  },
  {
    kicker: "Year 2",
    title: "Core skills",
    courses: [
      ["MATH 211", "Calculus III", "4 credits"],
      ["MATH 261", "Linear Algebra", "3 credits"],
      ["PHYS 211", "General Physics I", "4 credits"],
      ["PHYS 212", "General Physics II", "4 credits"],
      ["STAT 291", "Probability and Statistics", "3 credits"],
    ],
  },
  {
    kicker: "Year 3",
    title: "Application",
    courses: [
      ["MATH 301", "Numerical Analysis", "Course choice"],
      ["MATH 308", "Differential Equations", "3 credits"],
      ["MATH 341", "Mathematical Modeling", "Course choice"],
      ["MATH 342", "Applied Combinatorics", "Course choice"],
      ["MATH 362", "Algebraic Structures", "3 credits"],
    ],
  },
  {
    kicker: "Year 4",
    title: "Launch",
    courses: [
      ["MATH 405", "Introduction to Mathematical Research", "Course choice"],
      ["MATH 412", "Introduction to Real Analysis", "3 credits"],
      ["MATH 422", "Mathematics Research", "Course choice"],
      ["MATH 490", "Topics in Mathematics", "Course choice"],
      ["MATH 496", "Mathematics Capstone", "2 credits"],
    ],
  },
];

const distinctives = [
  "Take statistics courses taught by a Ph.D.-trained statistician.",
  "Present your work at Messiah’s Spring Symposium or at professional meetings.",
  "Learn from faculty whose research includes statistics, differential geometry and combinatorics.",
  "Pursue a statistics minor or combine mathematics with another major.",
  "Receive student journal memberships to the Mathematical Association of America and the American Statistical Association.",
  "Serve as a tutor or teaching assistant and join the Math Problem-Solving Club.",
];

const careers = [
  "Mathematician",
  "Actuary",
  "Researcher",
  "Teacher",
  "Actuarial analyst",
  "Operations research analyst",
  "Statistical analyst",
];

const employers = [
  "Epic Systems",
  "Infotech Consulting Inc.",
  "Pennsylvania Department of Health",
  "Mack Trucks Inc.",
  "Teach for America",
  "Naval Supply Systems Command",
];

const opportunities = [
  "Aetna Inc.",
  "Deloitte",
  "Highmark Health",
  "Nationwide Insurance",
  "Penn National Insurance",
  "The Hershey Company",
];

const relatedPrograms = [
  {
    title: "Accounting",
    image: "/images/programs/mathematics-related-accounting.jpg",
    alt: "Two students and a professor looking at a computer screen",
    href: "https://www.messiah.edu/undergraduate/accounting-major",
    types: ["Major", "Minor"],
  },
  {
    title: "Actuarial Science",
    image: "/images/programs/mathematics-related-actuarial.jpg",
    alt: "A student writing mathematical equations on a glass board",
    href: "https://www.messiah.edu/undergraduate/actuarial-science-major",
    types: ["Major"],
  },
  {
    title: "Finance",
    image: "/images/programs/mathematics-related-finance.webp",
    alt: "A professor and class looking at stock market information",
    href: "https://www.messiah.edu/undergraduate/finance-major",
    types: ["Major", "Minor"],
  },
  {
    title: "Statistics",
    image: "/images/programs/mathematics-related-statistics.png",
    alt: "Students looking at a presentation",
    href: "https://www.messiah.edu/undergraduate/statistics-minor",
    types: ["Minor"],
  },
];
---

<BaseLayout
  title="Mathematics Major"
  description="Discover Messiah University's Bachelor of Arts in mathematics, a broad liberal arts program that develops analytical, technical and communication skills."
>
  <main id="content" class="bg-white text-slate-900">
    <section
      class="relative isolate -mt-32 min-h-[650px] overflow-hidden bg-primary-800 text-white"
    >
      <img
        src="/images/programs/mathematics-hero-classroom.jpg"
        alt=""
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
        aria-hidden="true"
      />
      <div
        class="absolute inset-0 -z-10"
        style="background: linear-gradient(90deg, rgba(12, 37, 70, 0.88) 0%, rgba(39, 61, 94, 0.74) 34%, rgba(39, 61, 94, 0.36) 52%, rgba(39, 61, 94, 0) 72%);"
      >
      </div>

      <div
        class="mx-auto flex min-h-[650px] w-full max-w-7xl items-end px-5 pb-14 pt-40 sm:px-8 lg:py-20"
      >
        <div class="w-full max-w-5xl">
          <p class="text-xs font-bold uppercase tracking-[.18em] text-[#e5ae3a]">
            Bachelor of Arts
          </p>
          <h1
            class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 font-title text-4xl font-bold uppercase leading-[.92] tracking-[-.035em] sm:text-5xl lg:text-6xl"
          >
            Mathematics
            <span
              class="inline-flex items-center self-center bg-[#e5ae3a] px-3 py-2 font-sans text-lg font-bold normal-case tracking-normal text-primary-800 sm:text-xl"
              >B.A.</span
            >
          </h1>

          <ProgramList
            programs={[Program.Major, Program.Minor]}
            showText
            class="mt-7 text-lg sm:text-xl"
          />

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href="#next-steps"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-sm bg-[#e5ae3a] px-5 py-3 font-bold text-slate-950 no-underline transition hover:-translate-y-0.5 hover:bg-[#d59e2b]"
            >
              Your next steps <span class="text-lg" aria-hidden="true">↓</span>
            </a>
            <button
              type="button"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-sm border border-white/50 px-5 py-3 font-bold transition hover:-translate-y-0.5 hover:bg-white/10"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0 1 11.186 0Z"
                ></path>
              </svg>
              Save program
            </button>
          </div>
        </div>
      </div>
    </section>

    <nav
      data-page-navigation
      aria-label="On this page"
      class="sticky z-20 hidden overflow-x-auto border-b border-slate-200 bg-white/95 shadow-sm backdrop-blur lg:block"
      style="top: var(--global-nav-height, 0px)"
    >
      <div class="mx-auto flex min-w-max max-w-7xl items-center gap-6 px-5 py-4 text-sm sm:px-8">
        <strong class="shrink-0 text-primary-800">On this page</strong>
        {
          [
            ["Overview", "overview"],
            ["Why Messiah", "why-messiah"],
            ["Courses", "curriculum"],
            ["Careers & outcomes", "outcomes"],
            ["Career preperation", "experience"],
          ].map(([label, id]) => (
            <a
              href={`#${id}`}
              data-section-link
              class="relative shrink-0 py-1 text-slate-600 transition after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-[#e5ae3a] after:transition-transform hover:text-primary-800 data-[active=true]:font-bold data-[active=true]:text-primary-800 data-[active=true]:after:scale-x-100"
            >
              {label}
            </a>
          ))
        }
      </div>
    </nav>

    <section
      id="overview"
      class="mx-auto grid max-w-7xl items-center gap-12 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-16"
    >
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Logic meets possibility
        </p>
        <h2
          class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
        >
          Build analytical skill on a broad liberal arts foundation.
        </h2>
        <div class="mt-7 max-w-3xl space-y-5 text-lg leading-relaxed text-slate-600">
          <p>
            Messiah’s mathematics program develops the analytical and technical skills needed for
            mathematical work along with strong writing, communication and interdisciplinary skills.
          </p>
          <p>
            Study theoretical and applied mathematics as you prepare for employment in industry,
            business or government or for graduate study.
          </p>
        </div>
      </div>

      <img
        src="/images/programs/mathematics-overview.jpg"
        alt="A mathematics professor working through a problem with a student"
        class="aspect-video w-full object-cover shadow-xl"
      />
    </section>

    <section aria-labelledby="highlights-title" class="bg-primary-800 py-14 text-white md:py-16">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <p
          id="highlights-title"
          class="text-xs font-bold uppercase tracking-[.18em] text-[#e5ae3a]"
        >
          Mathematics at a glance
        </p>
        <div class="mt-6 grid border-y border-white/20 md:grid-cols-3">
          <article
            class="flex items-center gap-5 border-b border-white/20 py-7 md:border-b-0 md:border-r md:pr-8"
          >
            <strong class="shrink-0 font-title text-5xl text-[#e5ae3a]">100%</strong>
            <p class="m-0 text-sm leading-snug text-slate-100">
              of first-year students receive financial aid
            </p>
          </article>
          <article
            class="flex items-center gap-5 border-b border-white/20 py-7 md:border-b-0 md:border-r md:px-8"
          >
            <strong class="shrink-0 font-title text-5xl text-[#e5ae3a]">98%</strong>
            <p class="m-0 text-sm leading-snug text-slate-100">
              of the Class of 2025 respondents were employed or in graduate school within six to
              nine months of graduation
            </p>
          </article>
          <article class="flex items-center gap-5 py-7 md:pl-8">
            <strong class="shrink-0 font-title text-5xl text-[#e5ae3a]">12:1</strong>
            <p class="m-0 text-sm leading-snug text-slate-100">student-to-faculty ratio</p>
          </article>
        </div>
      </div>
    </section>

    <section id="why-messiah" class="bg-[#eaf2f6] py-24" aria-labelledby="distinctives-title">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
            Why mathematics at Messiah?
          </p>
          <h2
            id="distinctives-title"
            class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
          >
            Explore ideas, solve problems and communicate your work.
          </h2>
        </div>
        <div
          class="mt-12 grid gap-px overflow-hidden border border-slate-300 bg-slate-300 md:grid-cols-2 lg:grid-cols-3"
        >
          {
            distinctives.map((item, index) => (
              <article class="bg-white p-7">
                <span class="font-title text-2xl text-slate-400">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="mt-6 font-bold leading-relaxed text-primary-800">{item}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="curriculum" class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
      <div class="max-w-4xl">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Courses & curriculum
        </p>
        <h2
          class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
        >
          Build from calculus to advanced mathematical thinking.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          The mathematics major requires 59 credits. Students complete 123 total credits, including
          40 general education credits and 24 free elective credits.
        </p>
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          coursePlan.map((year) => (
            <article class="border-t-4 border-tertiary-400 bg-[#efefef] p-5">
              <p class="text-xs font-bold uppercase tracking-widest text-primary-800">
                {year.kicker}
              </p>
              <h3 class="mt-2 font-title text-2xl font-bold text-primary-800">{year.title}</h3>
              <ul class="mt-5 space-y-3 text-sm">
                {year.courses.map(([code, name, credits]) => (
                  <li class="border-b border-slate-300 pb-2 last:border-0">
                    <div class="flex items-start justify-between gap-3">
                      <strong class="text-primary-800">{code}</strong>
                      <span class="shrink-0 text-xs font-bold text-slate-700">{credits}</span>
                    </div>
                    <span class="mt-1 block text-slate-600">{name}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <p class="mt-8 max-w-5xl text-sm leading-relaxed text-slate-600">
        These example listings show up to five catalog requirements at each course level. They are
        not a complete course list or an official semester sequence. Students also complete nine
        credits from approved upper-level mathematics, statistics, data science or engineering
        options.
      </p>
      <a
        href="https://messiah.smartcatalogiq.com/2025-2026/undergraduate-catalog/school-of-science-engineering-and-health/department-of-computing-mathematics-and-physics/mathematics-b-a"
        class="mt-7 inline-flex min-h-12 items-center bg-primary-800 px-6 py-3 font-bold text-white transition hover:bg-primary-700"
      >
        View all courses →
      </a>
    </section>

    <section id="outcomes" class="bg-primary-800 py-24 text-white">
      <div class="mx-auto grid max-w-7xl gap-14 px-5 sm:px-8 lg:grid-cols-[.9fr_1.1fr] lg:gap-24">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.18em] text-[#e5ae3a]">
            Careers & outcomes
          </p>
          <h2 class="mt-3 font-title text-4xl leading-tight tracking-tight md:text-5xl">
            Turn mathematical thinking into meaningful work.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-200">
            Mathematics graduates are prepared for work in industry, business, government and
            education as well as graduate study in mathematics, statistics or education.
          </p>
          <strong class="mt-10 block font-title text-7xl text-[#e5ae3a]">98%</strong>
          <span class="block max-w-sm font-bold"
            >employed or in graduate school within six to nine months*</span
          >
          <small class="mt-3 block text-slate-400">*Class of 2025 respondents.</small>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          <article class="bg-white/5 p-7">
            <h3 class="font-title text-2xl">What graduates do</h3>
            <ul class="mt-5 space-y-3 text-slate-100">
              {
                careers.map((item) => (
                  <li class="flex gap-3">
                    <>
                      <span class="text-tertiary-400" aria-hidden="true">
                        ✓
                      </span>
                      <span>{item}</span>
                    </>
                  </li>
                ))
              }
            </ul>
          </article>
          <article class="bg-white/5 p-7">
            <h3 class="font-title text-2xl">Where graduates work</h3>
            <ul class="mt-5 space-y-3 text-slate-100">
              {
                employers.map((item) => (
                  <li class="flex gap-3">
                    <>
                      <span class="text-tertiary-400" aria-hidden="true">
                        ✓
                      </span>
                      <span>{item}</span>
                    </>
                  </li>
                ))
              }
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section
      id="experience"
      class="mx-auto grid max-w-7xl items-center gap-14 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:gap-20"
    >
      <Youtube
        videoId="GjSNNxVuoWA"
        preview="https://img.youtube.com/vi/GjSNNxVuoWA/hqdefault.jpg"
        class="w-full overflow-hidden shadow-xl"
      />
      <div>
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Career preperation
        </p>
        <h2
          class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
        >
          Put mathematics to work in real-world settings.
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          Messiah’s Experiential Learning Initiative gives students opportunities to apply classroom
          learning through internships, service learning, off-campus programs, leadership or
          undergraduate research.
        </p>
        <h3 class="mt-8 font-bold text-primary-800">Mathematics internship settings</h3>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            opportunities.map((item) => (
              <span class="rounded-full bg-[#efefef] px-3 py-2 text-sm">{item}</span>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-7xl gap-5 px-5 pb-24 sm:px-8 lg:grid-cols-3">
      <article class="border-t-4 border-tertiary-400 bg-[#efefef] p-8">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Teaching pathway
        </p>
        <h2 class="mt-3 font-title text-3xl text-primary-800">Secondary certification</h2>
        <p class="mt-4 text-slate-600">
          Add education courses that prepare you for certification to teach mathematics in grades
          7-12 in public or private schools.
        </p>
      </article>
      <article class="border-t-4 border-tertiary-400 bg-[#efefef] p-8">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Professional practice
        </p>
        <h2 class="mt-3 font-title text-3xl text-primary-800">Research and presentation</h2>
        <p class="mt-4 text-slate-600">
          Present your work at the annual Spring Symposium or at regional and national professional
          meetings attended by students and faculty.
        </p>
      </article>
      <article class="border-t-4 border-tertiary-400 bg-[#efefef] p-8">
        <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">
          Student community
        </p>
        <h2 class="mt-3 font-title text-3xl text-primary-800">Learn by helping and solving</h2>
        <p class="mt-4 text-slate-600">
          Serve as a tutor or teaching assistant or join the Math Problem-Solving Club to build
          mathematical models and sharpen problem-solving skills.
        </p>
      </article>
    </section>

    <section class="mx-auto max-w-7xl border-t border-slate-200 px-5 py-20 sm:px-8">
      <p class="text-xs font-bold uppercase tracking-[.18em] text-primary-800">Keep exploring</p>
      <h2
        class="mt-3 font-title text-4xl leading-[1.05] tracking-tight text-primary-800 md:text-5xl"
      >
        Related programs
      </h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          relatedPrograms.map((program) => (
            <a
              href={program.href}
              class="group overflow-hidden border border-slate-300 bg-white transition hover:border-tertiary-400 hover:shadow-lg"
            >
              <img
                src={program.image}
                alt={program.alt}
                class="aspect-[16/8] w-full object-cover transition duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="p-5">
                <h3 class="font-title text-2xl font-bold text-primary-800">{program.title}</h3>
                <div class="mt-4 flex flex-wrap gap-2">
                  {program.types.map((type) => (
                    <span class="rounded-full bg-[#eef4f7] px-3 py-1 text-xs font-bold text-primary-800">
                      {type}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section id="next-steps" class="bg-gradient-to-r from-[#11698c] to-[#0b7367] py-16 text-white">
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
          <div>
            <p class="text-xs font-bold uppercase tracking-[.18em]">Your next step</p>
            <h2 class="mt-3 font-title text-4xl leading-tight md:text-5xl">
              See where mathematics could take you.
            </h2>
          </div>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://www.messiah.edu/visit/"
              class="inline-flex min-h-12 items-center bg-[#e5ae3a] px-5 py-3 font-bold text-primary-800 transition hover:bg-white"
              >Plan a visit</a
            >
            <a
              href="https://www.messiah.edu/applytoday/"
              class="inline-flex min-h-12 items-center border border-white px-5 py-3 font-bold transition hover:bg-white hover:text-primary-800"
              >Apply to Messiah</a
            >
          </div>
        </div>

        <form
          action="/undergraduate-admissions/request-more-information/request-information"
          method="GET"
          class="mt-12 border-t border-white/30 pt-10"
        >
          <h3 class="font-title text-2xl font-bold uppercase">Request information</h3>
          <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_1.2fr_auto]">
            <input
              type="text"
              name="firstname"
              aria-label="First name"
              placeholder="First name"
              required
              class="h-14 w-full bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
            />
            <input
              type="text"
              name="lastname"
              aria-label="Last name"
              placeholder="Last name"
              required
              class="h-14 w-full bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
            />
            <input
              type="email"
              name="email"
              aria-label="Email"
              placeholder="Email"
              required
              class="h-14 w-full bg-white px-4 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#e5ae3a]"
            />
            <button
              type="submit"
              class="inline-flex min-h-12 items-center justify-center border border-white/80 px-5 py-3 font-bold uppercase tracking-wider transition hover:bg-white hover:text-primary-800"
              >Next</button
            >
          </div>
        </form>
      </div>
    </section>
  </main>

  <style is:global>
    #overview,
    #why-messiah,
    #curriculum,
    #outcomes,
    #experience,
    #next-steps {
      scroll-margin-top: var(--page-scroll-offset, 8rem);
    }
  </style>

  <script is:inline>
    (() => {
      const globalNavigation = document.querySelector("[data-global-navigation]");
      const pageNavigation = document.querySelector("[data-page-navigation]");

      if (!(globalNavigation instanceof HTMLElement) || !(pageNavigation instanceof HTMLElement))
        return;

      const links = Array.from(pageNavigation.querySelectorAll("[data-section-link]"));
      const sections = links
        .map((link) => document.querySelector(link.getAttribute("href")))
        .filter((section) => section instanceof HTMLElement);
      let animationFrame;

      const updateNavigation = () => {
        animationFrame = undefined;
        const globalHeight = Math.max(0, globalNavigation.getBoundingClientRect().bottom);
        const pageHeight = pageNavigation.offsetHeight;
        const offset = globalHeight + pageHeight + 24;
        document.documentElement.style.setProperty("--global-nav-height", `${globalHeight}px`);
        document.documentElement.style.setProperty("--page-scroll-offset", `${offset}px`);

        let activeSection = sections[0];
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= offset) activeSection = section;
        }

        links.forEach((link) => {
          link.dataset.active = String(link.getAttribute("href") === `#${activeSection?.id}`);
        });
      };

      const scheduleUpdate = () => {
        if (animationFrame) return;
        animationFrame = requestAnimationFrame(updateNavigation);
      };

      window.addEventListener("scroll", scheduleUpdate, { passive: true });
      window.addEventListener("resize", scheduleUpdate);
      new ResizeObserver(scheduleUpdate).observe(globalNavigation);
      updateNavigation();
    })();
  </script>
</BaseLayout>
