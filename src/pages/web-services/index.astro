---
import Sidebar from "../../components/sidebar.astro";
import WithHero from "../../layouts/with-hero.astro";
import Card from "../../components/card.astro";
import Drawer from "../../components/drawer.astro";
import Accordion from "../../components/accordion.astro";

const sidebarLinks = [
  {
    title: "Web Services",
    children: [
      { href: "#web-services-faqs", name: "FAQs" },
      { href: "/", name: "Project planning" },
      { href: "/", name: "Services provided" },
      { href: "/", name: "Support & training" },
      { href: "/", name: "Website governance" },
    ],
  },
  {
    title: "Quick Links",
    children: [
      { href: "/", name: "Sign up for training" },
      { href: "/", name: "Request access to edit site" },
    ],
  },
];
---

<WithHero
  title="Web Services at Messiah University"
  description="The Web Office at Messiah College is housed within the Office of Marketing and Public Relations and serves as the central office responsible for the College’s external website and related web services."
  image="/images/services-banner.jpg"
  analyticsKey="web-services"
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Campus Directory", href: "/" },
    { name: "Offices", href: "/" },
    { name: "Web Services", href: "/" },
  ]}
>
  <Sidebar links={sidebarLinks} slot="sidebar">
    <a href="/" class="btn-tertiary w-full">Submit a web services ticket</a>
  </Sidebar>

  <div class="rich-text">
    <h2>Welcome to Web Services</h2>

    <p>
      The Web Services Office at Messiah University, housed within the Office of Marketing and
      Communications, functions as the central hub overseeing the University's external website and
      associated web services. The office operates under the leadership of the Director of Web and
      Digital Marketing, with day-to-day management entrusted to the Web Services Manager.
    </p>

    <p>
      Our basic web design and consulting services are generally provided at no cost to campus
      clients. However, should the need arise for services beyond our internal capabilities,
      collaboration with an external vendor may be required, incurring additional expenses.
    </p>
  </div>

  <Card title="Need web help?">
    <p class="mb-4">
      The Web Services Team is responsible for overseeing the management of our helpdesk ticket
      program.
    </p>

    <p class="mb-4">
      If you encounter any issues on the Messiah University website, or if you need assistance with
      your website, please submit a helpdesk ticket by clicking the button below and we will address
      your concerns at the earliest opportunity.
    </p>

    <p class="mb-4">We are readily available and happy to assist you!</p>

    <a href="/" class="btn-tertiary not-prose">I need help with my website!</a>
  </Card>

  <div class="rich-text">
    <hr />

    <h2>Helpful resources to get you started</h2>

    <p>
      From time to time, you might have a straightforward question but might not be sure where to
      look. Find our web services FAQs and handy Jadu tutorials here for your convenience.
    </p>

    <ul class="not-prose flex gap-4">
      <li>
        <a
          href="#web-services-faqs"
          class="btn-tertiary"
          aria-haspopup="dialog"
          aria-controls="web-services-faqs">FAQs</a
        >
      </li>
      <li>
        <a href="/" class="btn-tertiary">Jadu tutorials</a>
      </li>
    </ul>
  </div>

  <Drawer id="web-services-faqs" title="Web Services FAQs">
    <p class="mb-6">
      Find answers to common questions about Web Services below. This is placeholder content;
      replace it with helpful information for your campus community.
    </p>

    <Accordion
      id="web-services-faq-request"
      title="How do I request help with my website?"
      allowProse
    >
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae neque eu justo
        facilisis consequat. Replace this text with instructions for requesting website support.
      </p>
    </Accordion>

    <Accordion
      id="web-services-faq-access"
      title="How do I get access to edit my website?"
      allowProse
    >
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec quis sapien sed nibh
        tincidunt volutpat. Replace this text with information about editor access and training.
      </p>
    </Accordion>

    <Accordion
      id="web-services-faq-training"
      title="Where can I find training resources?"
      allowProse
    >
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent at ligula vitae ipsum
        commodo malesuada. Replace this text with links to tutorials and upcoming training sessions.
      </p>
    </Accordion>
  </Drawer>
</WithHero>
