---
import Icon from "../../components/icon.astro";
---

<section
  class="relative overflow-hidden bg-white text-primary-800"
  x-show="meetsEmploymentRateThreshold()"
  x-data="{}"
  x-init="let animationFrame = null;
  let observer = null;

  $watch('selected', (value) => {
    if (!value?.employmentRate) return;

    const rate = Number(value.employmentRate);
    const elements = $root.querySelectorAll('[data-employment-rate]');

    if (animationFrame) cancelAnimationFrame(animationFrame);
    if (observer) observer.disconnect();

    elements.forEach((element) => element.textContent = '0%');

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      elements.forEach((element) => element.textContent = `${rate}%`);
      return;
    }

    observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;

      observer.disconnect();
      const startTime = performance.now();

      function step(currentTime) {
        const progress = Math.min((currentTime - startTime) / 1200, 1);
        elements.forEach((element) => element.textContent = `${Math.round(progress * rate)}%`);

        if (progress < 1) {
          animationFrame = requestAnimationFrame(step);
        }
      }

      animationFrame = requestAnimationFrame(step);
    }, { threshold: 0.25 });

    elements.forEach((element) => observer.observe(element));
  })"
>
  <div
    aria-hidden="true"
    class="absolute inset-y-0 right-0 hidden w-[54%] bg-tertiary-50 [clip-path:polygon(28%_0,100%_0,100%_100%,0_100%)] lg:block"
  >
  </div>
  <div
    aria-hidden="true"
    class="absolute -right-16 top-0 hidden size-72 rounded-full bg-tertiary-100/70 xl:block"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-6xl gap-14 px-4 py-16 md:py-20 lg:grid-cols-[0.85fr_1.35fr] lg:items-center lg:gap-16 lg:py-24 xl:py-28"
  >
    <div class="hidden text-center lg:block lg:text-left">
      <p
        class="font-title text-[clamp(6rem,15vw,11rem)] font-bold leading-[0.75] text-tertiary-400"
        data-employment-rate
      >
        0%
      </p>
      <div class="mx-auto mt-10 h-2 w-24 bg-tertiary-400 lg:mx-0"></div>
      <p
        class="mt-8 max-w-md text-lg leading-relaxed text-primary-700 md:text-xl"
        x-text="getEmploymentRateDescription()"
      >
      </p>
    </div>

    <div>
      <p
        class="mb-6 font-title text-xl font-bold uppercase tracking-[0.18em] text-primary-800 md:text-2xl"
        x-text="isAggregateSelected() ? 'Messiah University Graduates' : `Department of ${selected?.departmentName}`"
      >
      </p>
      <h2 class="mb-5 font-title text-5xl font-bold leading-[0.95] text-primary-800 md:text-6xl">
        Ready for what comes next.
      </h2>
      <p
        class="max-w-3xl text-xl leading-relaxed text-primary-700 md:text-2xl"
        x-text="isAggregateSelected()
          ? 'Messiah graduates turn their education into meaningful careers and continued professional growth.'
          : `Messiah Department of ${selected?.departmentName} graduates turn their education into meaningful careers and continued professional growth.`"
      >
      </p>

      <div class="relative mt-12 grid grid-cols-3 gap-2 text-center text-primary-800 md:gap-6">
        <div
          aria-hidden="true"
          class="absolute left-10 right-10 top-9 h-1 bg-tertiary-200 md:left-12 md:right-12 md:top-11"
        >
        </div>

        <div class="relative z-10 flex flex-col items-start text-left">
          <div
            class="flex size-20 items-center justify-center rounded-full border-[6px] border-tertiary-400 bg-white md:size-24"
          >
            <Icon name="check" class="size-9 stroke-[3]" />
          </div>
          <p class="mt-4 text-base font-semibold md:text-lg">Graduation</p>
          <p class="mt-1 text-sm text-primary-700 md:text-base">Degree completed</p>
        </div>

        <div class="relative z-10 flex flex-col items-center text-center">
          <div
            class="flex size-20 items-center justify-center rounded-full border-[6px] border-tertiary-400 bg-white font-title text-2xl font-bold md:size-24 md:text-3xl"
          >
            6–9
          </div>
          <p class="mt-4 text-base font-semibold md:text-lg">Months later</p>
          <p class="mt-1 text-sm text-primary-700 md:text-base">Outcome measured</p>
        </div>

        <div class="relative z-10 flex flex-col items-end text-right">
          <div
            class="flex size-20 items-center justify-center rounded-full bg-tertiary-400 font-title text-xl font-bold text-white md:size-24 md:text-2xl"
            x-text="`${selected?.employmentRate ?? 0}%`"
          >
          </div>
          <p class="mt-4 text-base font-semibold md:text-lg">Positive outcome</p>
          <p class="mt-1 text-sm text-primary-700 md:text-base">Work or further study</p>
        </div>
      </div>

      <div class="mt-16 text-center lg:hidden">
        <p
          class="font-title text-[clamp(6rem,28vw,11rem)] font-bold leading-[0.75] text-tertiary-400"
          data-employment-rate
        >
          0%
        </p>
        <div class="mx-auto mt-10 h-2 w-24 bg-tertiary-400"></div>
        <p
          class="mx-auto mt-8 max-w-md text-lg leading-relaxed text-primary-700 md:text-xl"
          x-text="getEmploymentRateDescription()"
        >
        </p>
      </div>

      <button
        type="button"
        @click="open = true"
        class="mt-10 font-semibold text-primary-700 underline decoration-2 underline-offset-4 transition-colors hover:text-tertiary-600"
      >
        About this outcome data
      </button>
    </div>
  </div>
</section>
