---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  eyebrow: string;
  title: string;
  imageUrl: string;
}

const { eyebrow, title, imageUrl } = Astro.props;
---

<section
  class="relative isolate -mt-32 min-h-[650px] overflow-hidden bg-primary-950 text-white lg:min-h-[720px] xl:min-h-[760px]"
>
  <img
    src={imageUrl}
    alt=""
    class="absolute inset-0 -z-30 h-full w-full object-cover object-center"
    aria-hidden="true"
  />
  <div
    class="absolute inset-0 -z-20"
    style="background: linear-gradient(90deg, rgba(13, 35, 61, 0.98) 0%, rgba(13, 35, 61, 0.9) 36%, rgba(13, 35, 61, 0.48) 68%, rgba(13, 35, 61, 0.08) 100%);"
  >
  </div>
  <div class="publication-dots" aria-hidden="true"></div>
  <div
    class="relative z-10 mx-auto flex min-h-[650px] max-w-7xl items-center px-5 pb-24 pt-44 sm:px-8 lg:min-h-[720px] lg:py-36 xl:min-h-[760px]"
  >
    <div class="lg:mt-8">
      <p class="mb-2 text-xs font-extrabold uppercase tracking-[.2em] text-mango-300">
        {eyebrow}
      </p>
      <h1
        class="font-title text-5xl font-bold leading-[.92] tracking-[-.035em] sm:text-6xl lg:text-7xl xl:text-8xl"
      >
        {title}
      </h1>
      <p class="mt-7 max-w-xl font-title text-2xl leading-relaxed text-white/85 lg:text-3xl">
        <slot />
      </p>
    </div>
  </div>
</section>
