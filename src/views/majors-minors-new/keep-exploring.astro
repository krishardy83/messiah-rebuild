---
interface Props {
  active: "az" | "interest" | "quiz";
}

const { active } = Astro.props;
---

<section class="bg-slate-100" aria-labelledby="more-ways-heading">
  <div
    class="mx-auto flex max-w-7xl flex-col justify-between gap-8 py-12 px-5 sm:px-8 lg:flex-row lg:items-center"
  >
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mb-2">Keep exploring</p>
      <h2 id="more-ways-heading" class="font-title text-3xl font-bold text-primary-950 sm:text-4xl">
        There’s more than one way to find academic programs.
      </h2>
    </div>

    <div class="flex shrink-0 flex-wrap gap-3">
      {
        active === "az" ? (
          <a
            href="/majors-minors-2c/"
            class="inline-flex min-h-12 items-center border border-primary-900 px-5 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-900 no-underline hover:bg-primary-900 hover:text-white"
          >
            Browse all interests
          </a>
        ) : null
      }
      {
        active === "interest" || active === "quiz" ? (
          <a
            href="/majors-minors-2b/"
            class="inline-flex min-h-12 items-center border border-primary-900 px-5 py-3 text-xs font-extrabold uppercase tracking-wider text-primary-900 no-underline hover:bg-primary-900 hover:text-white"
          >
            See the A–Z listing
          </a>
        ) : null
      }
      {
        active === "interest" || active === "az" ? (
          <a
            href="/majors-minors-quiz/"
            class="inline-flex min-h-12 items-center bg-primary-900 px-5 py-3 text-xs font-extrabold uppercase tracking-wider text-white no-underline hover:bg-primary-800"
          >
            Take the quiz
          </a>
        ) : null
      }
      {
        active === "quiz" ? (
          <a
            href="/majors-minors-2c/"
            class="inline-flex min-h-12 items-center bg-primary-900 px-5 py-3 text-xs font-extrabold uppercase tracking-wider text-white no-underline hover:bg-primary-800"
          >
            Browse all interests
          </a>
        ) : null
      }
    </div>
  </div>
</section>
